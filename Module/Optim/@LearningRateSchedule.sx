use STD.Math

package enum RateScheduleKind { constant; step; exponential; cosine }

public struct LearningRateSchedule {
    private let kind:RateScheduleKind
    private let initial_rate:float
    private let gamma:float
    private let interval:int
    private let minimum_rate:float

    private init(kind:RateScheduleKind,initial_rate:float,gamma:float,interval:int,minimum_rate:float) {
        self.kind=kind
        self.initial_rate=initial_rate
        self.gamma=gamma
        self.interval=interval
        self.minimum_rate=minimum_rate
    }

    package func checkpoint_state() RateScheduleState {
        return RateScheduleState(kind:self.kind,initial_rate:self.initial_rate,gamma:self.gamma,interval:self.interval,minimum_rate:self.minimum_rate)
    }
    package static func from_checkpoint(state:RateScheduleState) Result<LearningRateSchedule,str> {
        if !state_positive(state.initial_rate) || !state_positive(state.gamma) || state.interval<=0 ||
            !state_positive(state.minimum_rate) || state.minimum_rate>state.initial_rate {
            return Result<LearningRateSchedule,str>.failure("Tensor.Neural.TrainingCheckpoint contains an invalid learning-rate schedule")
        }
        if state.kind==RateScheduleKind.constant && (state.gamma!=1.0 || state.interval!=1 || state.minimum_rate!=state.initial_rate) {
            return Result<LearningRateSchedule,str>.failure("Tensor.Neural.TrainingCheckpoint contains an invalid constant schedule")
        }
        if state.kind==RateScheduleKind.step && state.minimum_rate!=state.initial_rate {
            return Result<LearningRateSchedule,str>.failure("Tensor.Neural.TrainingCheckpoint contains an invalid step schedule")
        }
        if state.kind==RateScheduleKind.exponential && (state.interval!=1 || state.minimum_rate!=state.initial_rate) {
            return Result<LearningRateSchedule,str>.failure("Tensor.Neural.TrainingCheckpoint contains an invalid exponential schedule")
        }
        if state.kind==RateScheduleKind.cosine && state.gamma!=1.0 {
            return Result<LearningRateSchedule,str>.failure("Tensor.Neural.TrainingCheckpoint contains an invalid cosine schedule")
        }
        return Result<LearningRateSchedule,str>.success(LearningRateSchedule(state.kind,state.initial_rate,state.gamma,state.interval,state.minimum_rate))
    }

    static func constant(learning_rate:float) LearningRateSchedule {
        require_positive(learning_rate,"learning_rate","LearningRateSchedule.constant")
        return LearningRateSchedule(RateScheduleKind.constant,learning_rate,1.0,1,learning_rate)
    }

    static func step(learning_rate:float,step_size:int,gamma:float) LearningRateSchedule {
        require_positive(learning_rate,"learning_rate","LearningRateSchedule.step")
        require_positive(gamma,"gamma","LearningRateSchedule.step")
        if step_size<=0 {panic("Tensor.Optim.LearningRateSchedule.step requires step_size > 0")}
        return LearningRateSchedule(RateScheduleKind.step,learning_rate,gamma,step_size,learning_rate)
    }

    static func exponential(learning_rate:float,gamma:float) LearningRateSchedule {
        require_positive(learning_rate,"learning_rate","LearningRateSchedule.exponential")
        require_positive(gamma,"gamma","LearningRateSchedule.exponential")
        return LearningRateSchedule(RateScheduleKind.exponential,learning_rate,gamma,1,learning_rate)
    }

    static func cosine(learning_rate:float,duration:int,minimum_rate:float) LearningRateSchedule {
        require_positive(learning_rate,"learning_rate","LearningRateSchedule.cosine")
        require_positive(minimum_rate,"minimum_rate","LearningRateSchedule.cosine")
        if duration<=0 {panic("Tensor.Optim.LearningRateSchedule.cosine requires duration > 0")}
        if minimum_rate>learning_rate {panic("Tensor.Optim.LearningRateSchedule.cosine requires minimum_rate <= learning_rate")}
        return LearningRateSchedule(RateScheduleKind.cosine,learning_rate,1.0,duration,minimum_rate)
    }

    func value_at(step:int) float {
        if step<0 {panic("Tensor.Optim.LearningRateSchedule.value_at requires step >= 0")}
        var rate=self.initial_rate
        match self.kind {
            constant => {}
            step => {rate*=optimizer_power(self.gamma,step/self.interval)}
            exponential => {rate*=optimizer_power(self.gamma,step)}
            cosine => {
                if step>=self.interval {rate=self.minimum_rate}
                else if step>0 {
                    let fraction=(step as float)/(self.interval as float)
                    rate=self.minimum_rate+(self.initial_rate-self.minimum_rate)*(1.0+Math.cos(Math.pi()*fraction))*0.5
                }
            }
        }
        require_positive(rate,"result","LearningRateSchedule.value_at")
        return rate
    }
}

package struct RateScheduleState {
    let kind:RateScheduleKind
    let initial_rate:float
    let gamma:float
    let interval:int
    let minimum_rate:float
}
