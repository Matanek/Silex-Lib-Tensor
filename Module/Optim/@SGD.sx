use STD.Math
use Tensor
use Tensor.Neural.Parameter

class SGDSlot {
    var initialized:bool
    var momentum_buffer:Tensor

    init() {
        self.initialized = false
        self.momentum_buffer = Tensor.scalar(0.0)
    }
}

public nocopy class SGD {
    private var parameters:Parameter[]
    private var states:SGDSlot[]
    private var current_learning_rate:float
    private var momentum:float
    private var weight_decay:float

    init(
        parameters:Parameter[], learning_rate:float,
        momentum:float = 0.0, weight_decay:float = 0.0
    ) {
        require_positive(learning_rate, "learning_rate", "SGD")
        require_non_negative(momentum, "momentum", "SGD")
        require_non_negative(weight_decay, "weight_decay", "SGD")
        self.parameters = optimizer_parameters(parameters, "SGD")
        self.states = []
        for parameter in self.parameters { self.states.append(SGDSlot()) }
        self.current_learning_rate = learning_rate
        self.momentum = momentum
        self.weight_decay = weight_decay
    }

    func learning_rate() float {return self.current_learning_rate}
    func set_learning_rate(value:float) {
        require_positive(value,"learning_rate","SGD.set_learning_rate")
        self.current_learning_rate=value
    }

    func zero_grad() { optimizer_zero_grad(self.parameters) }

    func clip_grad_norm(
        maximum_norm:float,
        nonfinite:NonFiniteGradientPolicy = NonFiniteGradientPolicy.propagate
    ) Tensor {
        require_non_negative(maximum_norm, "maximum_norm", "clip_grad_norm")
        let reference = self.parameters[0].value().detach()
        var index = 0
        while index < self.parameters.count() {
            if !self.parameters[index].value().same_optimizer_placement(reference) {
                panic("Tensor.Optim.clip_grad_norm requires all parameters on one placement")
            }
            let gradient = optimizer_gradient(self.parameters[index], "clip_grad_norm")
            index++
        }
        var squared_norm = reference.autograd_constant_shape([], 0.0)
        index = 0
        while index < self.parameters.count() {
            if let gradient = optimizer_gradient(self.parameters[index], "clip_grad_norm") {
                if !gradient.is_empty() {
                    squared_norm = squared_norm.add(gradient.multiply(gradient).sum())
                }
            }
            index++
        }
        let norm = squared_norm.sqrt().detach()
        if nonfinite == NonFiniteGradientPolicy.reject {
            let observed = norm.cpu().item()
            if !Math.is_finite(observed) {
                panic("Tensor.Optim.clip_grad_norm rejected a non-finite global gradient norm")
            }
        }
        let one = reference.autograd_constant_shape([], 1.0)
        let maximum = reference.autograd_constant_shape([], maximum_norm)
        let ratio = maximum.divide(norm.add(0.000001))
        let factor = one.subtract(one.subtract(ratio).relu())
        index = 0
        while index < self.parameters.count() {
            if let gradient = optimizer_gradient(self.parameters[index], "clip_grad_norm") {
                self.parameters[index].replace_gradient(gradient.multiply(factor).detach())
            }
            index++
        }
        return norm
    }

    func step() {
        var index = 0
        while index < self.parameters.count() {
            var parameter = self.parameters[index]
            if self.states[index].initialized {
                require_optimizer_tensor(
                    parameter, self.states[index].momentum_buffer,
                    "momentum state", "SGD.step"
                )
            }
            let gradient = optimizer_gradient(parameter, "SGD.step")
            index++
        }

        index = 0
        while index < self.parameters.count() {
            var parameter = self.parameters[index]
            var state = self.states[index]
            if let incoming = optimizer_gradient(parameter, "SGD.step") {
                var gradient = incoming
                if self.weight_decay != 0.0 {
                    gradient = gradient.add(parameter.value().detach().multiply(self.weight_decay))
                }
                var direction = gradient
                if self.momentum != 0.0 {
                    if state.initialized {
                        direction = state.momentum_buffer.multiply(self.momentum).add(gradient)
                    }
                }
                let next_value = parameter.value().detach().subtract(
                    direction.multiply(self.current_learning_rate)
                ).detach()
                parameter.apply(next_value)
                if self.momentum != 0.0 {
                    state.momentum_buffer = direction.detach()
                    state.initialized = true
                }
            }
            index++
        }
    }

    func state() SGDState {
        var entries:SGDMomentumState[]=[]
        var index=0
        while index<self.parameters.count() {
            var value:Tensor?=null
            if self.states[index].initialized {value=self.states[index].momentum_buffer.detach()}
            entries.append(SGDMomentumState(name:self.parameters[index].name(),shape:optimizer_state_shape(self.parameters[index].value().shape()),momentum:value))
            index++
        }
        return SGDState(learning_rate:self.current_learning_rate,momentum:self.momentum,weight_decay:self.weight_decay,parameters:entries)
    }

    package func checkpoint_parameters(expected:Parameter[]) Result<void,str> {return validate_checkpoint_parameters(self.parameters,expected)}

    func restore(snapshot:SGDState) Result<void,str> {return self.restore_state(snapshot,true)}
    package func validate_restore(snapshot:SGDState) Result<void,str> {return self.restore_state(snapshot,false)}

    private func restore_state(snapshot:SGDState,apply:bool) Result<void,str> {
        if !state_positive(snapshot.learning_rate) || !state_nonnegative(snapshot.momentum) || !state_nonnegative(snapshot.weight_decay) {
            return Result<void,str>.failure("Tensor.Optim.SGD.restore requires valid hyperparameters")
        }
        if snapshot.parameters.count()!=self.parameters.count() {return Result<void,str>.failure("Tensor.Optim.restore requires matching parameter names")}
        var restored:SGDSlot[]=[]
        for parameter in self.parameters {
            if parameter.gradient()!=null {return Result<void,str>.failure("Tensor.Optim.restore requires zero_grad before restoring state")}
            var found=-1
            var index=0
            while index<snapshot.parameters.count() {
                if snapshot.parameters[index].name==parameter.name() {
                    if found>=0 {return Result<void,str>.failure("Tensor.Optim.restore requires unique parameter names")}
                    found=index
                }
                index++
            }
            if found<0 {return Result<void,str>.failure("Tensor.Optim.restore requires matching parameter names")}
            var entry=snapshot.parameters[found]
            if !optimizer_shapes_equal(entry.shape,parameter.value().shape()) {return Result<void,str>.failure("Tensor.Optim.restore requires matching parameter shapes")}
            var slot=SGDSlot()
            if let value=entry.momentum {
                if snapshot.momentum==0.0 {return Result<void,str>.failure("Tensor.Optim.SGD.restore cannot restore momentum with momentum zero")}
                try validate_state_tensor(parameter,value)
                slot.momentum_buffer=value.detach();slot.initialized=true
            }
            restored.append(slot)
        }
        if apply {
            self.states=restored
            self.current_learning_rate=snapshot.learning_rate
            self.momentum=snapshot.momentum
            self.weight_decay=snapshot.weight_decay
        }
        return Result<void,str>.success()
    }

    package func momentum_state(name:str) Tensor? {
        var index = 0
        while index < self.parameters.count() {
            if self.parameters[index].name() == name {
                if self.states[index].initialized { return self.states[index].momentum_buffer }
                return null
            }
            index++
        }
        panic("Tensor.Optim.SGD has no parameter named '$(name)'")
    }
}
