use STD.Math
use Tensor
use Tensor.Neural.Parameter

class AdamState {
    var step_count:int
    var first_moment:Tensor
    var second_moment:Tensor

    init() {
        self.step_count = 0
        self.first_moment = Tensor.scalar(0.0)
        self.second_moment = Tensor.scalar(0.0)
    }
}

public nocopy class Adam {
    private var parameters:Parameter[]
    private var states:AdamState[]
    private let learning_rate:float
    private let beta1:float
    private let beta2:float
    private let epsilon:float
    private let weight_decay:float

    init(
        parameters:Parameter[], learning_rate:float = 0.001,
        beta1:float = 0.9, beta2:float = 0.999,
        epsilon:float = 0.00000001, weight_decay:float = 0.0
    ) {
        require_positive(learning_rate, "learning_rate", "Adam")
        require_unit_interval(beta1, "beta1", "Adam")
        require_unit_interval(beta2, "beta2", "Adam")
        require_positive(epsilon, "epsilon", "Adam")
        require_non_negative(weight_decay, "weight_decay", "Adam")
        self.parameters = optimizer_parameters(parameters, "Adam")
        self.states = []
        for parameter in self.parameters { self.states.append(AdamState()) }
        self.learning_rate = learning_rate
        self.beta1 = beta1
        self.beta2 = beta2
        self.epsilon = epsilon
        self.weight_decay = weight_decay
    }

    func zero_grad() { optimizer_zero_grad(self.parameters) }

    func clip_grad_norm(
        maximum_norm:float,
        nonfinite:NonFiniteGradientPolicy = NonFiniteGradientPolicy.propagate
    ) Tensor {
        require_non_negative(maximum_norm, "maximum_norm", "clip_grad_norm")
        let reference = self.parameters[0].value().detach()
        var index = 0
        while index < self.parameters.count() {
            if !self.parameters[index].value().same_optimizer_placement(reference) {
                panic("Tensor.Optim.clip_grad_norm requires all parameters on one placement")
            }
            let gradient = optimizer_gradient(self.parameters[index], "clip_grad_norm")
            index++
        }
        var squared_norm = reference.autograd_constant_shape([], 0.0)
        index = 0
        while index < self.parameters.count() {
            if let gradient = self.parameters[index].gradient() {
                if !gradient.is_empty() {
                    squared_norm = squared_norm.add(gradient.multiply(gradient).sum())
                }
            }
            index++
        }
        let norm = squared_norm.sqrt().detach()
        if nonfinite == NonFiniteGradientPolicy.reject {
            let observed = norm.cpu().item()
            if !Math.is_finite(observed) {
                panic("Tensor.Optim.clip_grad_norm rejected a non-finite global gradient norm")
            }
        }
        let one = reference.autograd_constant_shape([], 1.0)
        let maximum = reference.autograd_constant_shape([], maximum_norm)
        let ratio = maximum.divide(norm.add(0.000001))
        let factor = one.subtract(one.subtract(ratio).relu())
        index = 0
        while index < self.parameters.count() {
            if let gradient = self.parameters[index].gradient() {
                self.parameters[index].replace_gradient(gradient.multiply(factor).detach())
            }
            index++
        }
        return norm
    }

    func step() {
        var index = 0
        while index < self.parameters.count() {
            var parameter = self.parameters[index]
            if self.states[index].step_count > 0 {
                require_optimizer_tensor(
                    parameter, self.states[index].first_moment,
                    "first-moment state", "Adam.step"
                )
                require_optimizer_tensor(
                    parameter, self.states[index].second_moment,
                    "second-moment state", "Adam.step"
                )
            }
            let gradient = optimizer_gradient(parameter, "Adam.step")
            index++
        }

        index = 0
        while index < self.parameters.count() {
            var parameter = self.parameters[index]
            var state = self.states[index]
            if let incoming = parameter.gradient() {
                var gradient = incoming
                if self.weight_decay != 0.0 {
                    gradient = gradient.add(parameter.value().detach().multiply(self.weight_decay))
                }
                var first = parameter.value().detach().multiply(0.0)
                var second = parameter.value().detach().multiply(0.0)
                if state.step_count > 0 {
                    first = state.first_moment
                    second = state.second_moment
                }
                first = first.multiply(self.beta1).add(gradient.multiply(1.0 - self.beta1)).detach()
                second = second.multiply(self.beta2).add(gradient.multiply(gradient).multiply(1.0 - self.beta2)).detach()
                let next_step = state.step_count + 1
                let first_correction = 1.0 - optimizer_power(self.beta1, next_step)
                let second_correction = 1.0 - optimizer_power(self.beta2, next_step)
                let numerator = first.divide(first_correction)
                let denominator = second.divide(second_correction).sqrt().add(self.epsilon)
                let next_value = parameter.value().detach().subtract(
                    numerator.divide(denominator).multiply(self.learning_rate)
                ).detach()
                parameter.apply(next_value)
                state.first_moment = first.detach()
                state.second_moment = second.detach()
                state.step_count = next_step
            }
            index++
        }
    }

    package func first_moment_state(name:str) Tensor? { return self.moment_state(name, true) }
    package func second_moment_state(name:str) Tensor? { return self.moment_state(name, false) }
    package func state_step(name:str) int {
        var index = self.parameter_index(name)
        return self.states[index].step_count
    }

    private func moment_state(name:str, first:bool) Tensor? {
        var index = self.parameter_index(name)
        if self.states[index].step_count == 0 { return null }
        if first { return self.states[index].first_moment }
        return self.states[index].second_moment
    }

    private func parameter_index(name:str) int {
        var index = 0
        while index < self.parameters.count() {
            if self.parameters[index].name() == name { return index }
            index++
        }
        panic("Tensor.Optim.Adam has no parameter named '$(name)'")
    }
}

func optimizer_power(base:float, exponent:int) float {
    var result = 1.0
    var index = 0
    while index < exponent {
        result *= base
        index++
    }
    return result
}
