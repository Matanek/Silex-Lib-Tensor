use GFX.GPU
public use Tensor.DType.DType

public struct Tensor {
    private var current_storage:Storage
    private let current_layout:Layout

    init(values:float[], shape:int[]) { require_element_count(shape, values.count(), 4); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:int8[], shape:int[]) { require_element_count(shape, values.count(), 1); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:uint8[], shape:int[]) { require_element_count(shape, values.count(), 1); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:int16[], shape:int[]) { require_element_count(shape, values.count(), 2); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:uint16[], shape:int[]) { require_element_count(shape, values.count(), 2); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:int32[], shape:int[]) { require_element_count(shape, values.count(), 4); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:uint32[], shape:int[]) { require_element_count(shape, values.count(), 4); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:int64[], shape:int[]) { require_element_count(shape, values.count(), 8); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }
    init(values:uint64[], shape:int[]) { require_element_count(shape, values.count(), 8); self.current_storage = Storage.cpu(CPUStorage(values)); self.current_layout = Layout(shape) }

    static func scalar(value:float) Tensor { var values:float[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:int8) Tensor { var values:int8[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:uint8) Tensor { var values:uint8[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:int16) Tensor { var values:int16[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:uint16) Tensor { var values:uint16[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:int32) Tensor { var values:int32[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:uint32) Tensor { var values:uint32[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:int64) Tensor { var values:int64[] = [value]; var shape:int[] = []; return Tensor(values, shape) }
    static func scalar(value:uint64) Tensor { var values:uint64[] = [value]; var shape:int[] = []; return Tensor(values, shape) }

    static func vector(values:float[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:int8[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:uint8[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:int16[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:uint16[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:int32[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:uint32[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:int64[]) Tensor { return Tensor(values, vector_shape(values.count())) }
    static func vector(values:uint64[]) Tensor { return Tensor(values, vector_shape(values.count())) }

    static func matrix(values:float[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:int8[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:uint8[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:int16[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:uint16[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:int32[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:uint32[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:int64[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }
    static func matrix(values:uint64[], rows:int, columns:int) Tensor { return Tensor(values, matrix_shape(rows, columns)) }

    static func zeros(shape:int[], dtype:DType = DType.float32()) Tensor { return Tensor.filled(shape, dtype, 0.0) }
    static func ones(shape:int[], dtype:DType = DType.float32()) Tensor { return Tensor.filled(shape, dtype, 1.0) }
    static func full(shape:int[], value:float) Tensor { return Tensor.full_values<float>(shape, value, 4) }
    static func full(shape:int[], value:int8) Tensor { return Tensor.full_values<int8>(shape, value, 1) }
    static func full(shape:int[], value:uint8) Tensor { return Tensor.full_values<uint8>(shape, value, 1) }
    static func full(shape:int[], value:int16) Tensor { return Tensor.full_values<int16>(shape, value, 2) }
    static func full(shape:int[], value:uint16) Tensor { return Tensor.full_values<uint16>(shape, value, 2) }
    static func full(shape:int[], value:int32) Tensor { return Tensor.full_values<int32>(shape, value, 4) }
    static func full(shape:int[], value:uint32) Tensor { return Tensor.full_values<uint32>(shape, value, 4) }
    static func full(shape:int[], value:int64) Tensor { return Tensor.full_values<int64>(shape, value, 8) }
    static func full(shape:int[], value:uint64) Tensor { return Tensor.full_values<uint64>(shape, value, 8) }

    func shape() int[] { return self.current_layout.shape() }
    func strides() int[] { return self.current_layout.strides() }
    func offset() int { return self.current_layout.offset() }
    func rank() int { return self.current_layout.rank() }
    func count() int { return self.current_layout.count() }
    func is_empty() bool { return self.count() == 0 }
    func is_contiguous() bool { return self.current_layout.is_contiguous() }
    func is_cpu() bool { return match self.current_storage { gpu(value) => false; else => true } }
    func is_gpu() bool { return !self.is_cpu() }
    func dtype() DType { return match self.current_storage { cpu(value) => value.dtype(); gpu(value) => value.dtype() } }

    func values() float[] { self.require_extraction(DType.float32(), "values"); return gather_values<float>(self.cpu_storage().float_values(), self.current_layout) }
    func int8_values() int8[] { self.require_extraction(DType.int8(), "int8_values"); return gather_values<int8>(self.cpu_storage().int8_values(), self.current_layout) }
    func uint8_values() uint8[] { self.require_extraction(DType.uint8(), "uint8_values"); return gather_values<uint8>(self.cpu_storage().uint8_values(), self.current_layout) }
    func int16_values() int16[] { self.require_extraction(DType.int16(), "int16_values"); return gather_values<int16>(self.cpu_storage().int16_values(), self.current_layout) }
    func uint16_values() uint16[] { self.require_extraction(DType.uint16(), "uint16_values"); return gather_values<uint16>(self.cpu_storage().uint16_values(), self.current_layout) }
    func int32_values() int32[] { self.require_extraction(DType.int32(), "int32_values"); return gather_values<int32>(self.cpu_storage().int32_values(), self.current_layout) }
    func uint32_values() uint32[] { self.require_extraction(DType.uint32(), "uint32_values"); return gather_values<uint32>(self.cpu_storage().uint32_values(), self.current_layout) }
    func int64_values() int64[] { self.require_extraction(DType.int64(), "int64_values"); return gather_values<int64>(self.cpu_storage().int64_values(), self.current_layout) }
    func uint64_values() uint64[] { self.require_extraction(DType.uint64(), "uint64_values"); return gather_values<uint64>(self.cpu_storage().uint64_values(), self.current_layout) }

    func item() float { return only_item<float>(self.values(), "item") }
    func int8_item() int8 { return only_item<int8>(self.int8_values(), "int8_item") }
    func uint8_item() uint8 { return only_item<uint8>(self.uint8_values(), "uint8_item") }
    func int16_item() int16 { return only_item<int16>(self.int16_values(), "int16_item") }
    func uint16_item() uint16 { return only_item<uint16>(self.uint16_values(), "uint16_item") }
    func int32_item() int32 { return only_item<int32>(self.int32_values(), "int32_item") }
    func uint32_item() uint32 { return only_item<uint32>(self.uint32_values(), "uint32_item") }
    func int64_item() int64 { return only_item<int64>(self.int64_values(), "int64_item") }
    func uint64_item() uint64 { return only_item<uint64>(self.uint64_values(), "uint64_item") }

    func at(indices:int[]) float { self.require_extraction(DType.float32(), "at"); return self.cpu_storage().float_values()[self.current_layout.storage_index(indices)] }
    func int8_at(indices:int[]) int8 { self.require_extraction(DType.int8(), "int8_at"); return self.cpu_storage().int8_values()[self.current_layout.storage_index(indices)] }
    func uint8_at(indices:int[]) uint8 { self.require_extraction(DType.uint8(), "uint8_at"); return self.cpu_storage().uint8_values()[self.current_layout.storage_index(indices)] }
    func int16_at(indices:int[]) int16 { self.require_extraction(DType.int16(), "int16_at"); return self.cpu_storage().int16_values()[self.current_layout.storage_index(indices)] }
    func uint16_at(indices:int[]) uint16 { self.require_extraction(DType.uint16(), "uint16_at"); return self.cpu_storage().uint16_values()[self.current_layout.storage_index(indices)] }
    func int32_at(indices:int[]) int32 { self.require_extraction(DType.int32(), "int32_at"); return self.cpu_storage().int32_values()[self.current_layout.storage_index(indices)] }
    func uint32_at(indices:int[]) uint32 { self.require_extraction(DType.uint32(), "uint32_at"); return self.cpu_storage().uint32_values()[self.current_layout.storage_index(indices)] }
    func int64_at(indices:int[]) int64 { self.require_extraction(DType.int64(), "int64_at"); return self.cpu_storage().int64_values()[self.current_layout.storage_index(indices)] }
    func uint64_at(indices:int[]) uint64 { self.require_extraction(DType.uint64(), "uint64_at"); return self.cpu_storage().uint64_values()[self.current_layout.storage_index(indices)] }

    func reshape(shape:int[]) Tensor { return Tensor.from_storage(self.current_storage, self.current_layout.reshaped(shape)) }
    func flatten() Tensor { return self.reshape(vector_shape(self.count())) }
    func permute(axes:int[]) Tensor { return Tensor.from_storage(self.current_storage, self.current_layout.permuted(axes)) }
    func transpose() Tensor {
        if self.rank() != 2 { panic("Tensor.transpose requires rank 2; use permute(axes) for other ranks") }
        return self.permute([1, 0])
    }
    func select(axis:int, index:int) Tensor { return Tensor.from_storage(self.current_storage, self.current_layout.selected(axis, index)) }
    func narrow(axis:int, start:int, count:int) Tensor { return Tensor.from_storage(self.current_storage, self.current_layout.narrowed(axis, start, count)) }
    func contiguous() Tensor {
        if self.current_layout.is_canonical(self.storage_count()) { return self }
        let layout = Layout(self.current_layout.shape())
        return match self.current_storage {
            cpu(value) => Tensor.from_storage(Storage.cpu(value.materialized(self.current_layout)), layout)
            gpu(value) => Tensor.from_storage(Storage.gpu(value.contiguous(self.current_layout)), layout)
        }
    }

    func cast(dtype:DType) Tensor {
        if self.is_gpu() { panic("Tensor.cast is CPU-only; call cpu().cast(dtype)") }
        if dtype == self.dtype() { return self }
        let physical_size = checked_byte_count(self.count(), dtype.byte_width())
        var storage = cast_storage(self.cpu_storage(), self.current_layout, dtype)
        return Tensor.from_storage(Storage.cpu(storage), Layout(self.current_layout.shape()))
    }

    func to(device:GPU.Device) Tensor {
        return match self.current_storage {
            cpu(value) => Tensor.from_storage(Storage.gpu(value.gpu(device)), self.current_layout)
            gpu(value) => self.same_gpu_or_fail(value, device)
        }
    }
    func cpu() Tensor {
        return match self.current_storage { gpu(value) => Tensor.from_storage(Storage.cpu(value.cpu_storage()), self.current_layout); else => self }
    }

    private static func from_storage(storage:Storage, layout:Layout) Tensor { return Tensor(values:storage, shape:layout) }
    private init(values:Storage, shape:Layout) { self.current_storage = values; self.current_layout = shape }

    private static func filled(shape:int[], dtype:DType, value:float) Tensor {
        let count = shape_product(shape)
        let physical_size = checked_byte_count(count, dtype.byte_width())
        if dtype == DType.float32() { return Tensor.full_values<float>(shape, value, 4) }
        if dtype == DType.int8() { return Tensor.full_values<int8>(shape, value as int8, 1) }
        if dtype == DType.uint8() { return Tensor.full_values<uint8>(shape, value as uint8, 1) }
        if dtype == DType.int16() { return Tensor.full_values<int16>(shape, value as int16, 2) }
        if dtype == DType.uint16() { return Tensor.full_values<uint16>(shape, value as uint16, 2) }
        if dtype == DType.int32() { return Tensor.full_values<int32>(shape, value as int32, 4) }
        if dtype == DType.uint32() { return Tensor.full_values<uint32>(shape, value as uint32, 4) }
        if dtype == DType.int64() { return Tensor.full_values<int64>(shape, value as int64, 8) }
        return Tensor.full_values<uint64>(shape, value as uint64, 8)
    }
    private static func full_values<T>(shape:int[], value:T, width:int) Tensor {
        let count = shape_product(shape)
        let physical_size = checked_byte_count(count, width)
        var values:T[] = []
        var index = 0
        while index < count { values.append(value); index++ }
        return Tensor(values, shape)
    }

    module func binary(other:Tensor, operation:BinaryOperation) Tensor {
        self.require_binary_compatibility(other, operation)
        let shape = broadcast_shape(self.shape(), other.shape(), binary_name(operation))
        if self.is_gpu() {
            self.require_gpu_float_compute(binary_name(operation))
            var left = self.gpu_storage()
            var right = other.gpu_storage()
            return Tensor.from_storage(
                Storage.gpu(left.binary(right, self.current_layout, other.current_layout, shape, operation)),
                Layout(shape)
            )
        }
        return Tensor.from_storage(
            Storage.cpu(binary_cpu_storage(
                self.cpu_storage(), self.current_layout,
                other.cpu_storage(), other.current_layout,
                shape, operation
            )),
            Layout(shape)
        )
    }

    module func float_scalar(value:float, operation:BinaryOperation) Tensor {
        if self.is_gpu() {
            self.require_gpu_float_compute(binary_name(operation))
            var storage = self.gpu_storage()
            return Tensor.from_storage(
                Storage.gpu(storage.scalar(self.current_layout, operation, value)),
                Layout(self.current_layout.shape())
            )
        }
        return self.binary(Tensor.scalar(value), operation)
    }

    module func integer_scalar(other:Tensor, operation:BinaryOperation) Tensor {
        if self.is_gpu() { self.require_gpu_float_compute(binary_name(operation)) }
        return self.binary(other, operation)
    }

    module func unary(operation:UnaryOperation) Tensor {
        if self.is_gpu() {
            self.require_gpu_float_compute(unary_name(operation))
            var storage = self.gpu_storage()
            return Tensor.from_storage(
                Storage.gpu(storage.unary(self.current_layout, operation)),
                Layout(self.current_layout.shape())
            )
        }
        require_unary_dtype(self.dtype(), operation)
        return Tensor.from_storage(
            Storage.cpu(unary_cpu_storage(self.cpu_storage(), self.current_layout, operation)),
            Layout(self.current_layout.shape())
        )
    }

    private func require_binary_compatibility(other:Tensor, operation:BinaryOperation) {
        let name = binary_name(operation)
        if self.dtype() != other.dtype() { panic("Tensor.$(name) requires matching dtypes") }
        if self.is_cpu() != other.is_cpu() { panic("Tensor.$(name) requires matching placements") }
        if self.is_gpu() {
            var left = self.gpu_storage()
            var right = other.gpu_storage()
            if !left.same_device(right) { panic("Tensor.$(name) requires tensors on the same GPU device") }
        }
    }

    private func require_gpu_float_compute(operation:str) {
        if self.dtype() != DType.float32() {
            panic("Tensor.$(operation) GPU computation supports only dtype float32; call cpu().cast(DType.float32()).to(device)")
        }
    }

    private func storage_count() int { return match self.current_storage { cpu(value) => value.count(); gpu(value) => value.count() } }
    private func cpu_storage() CPUStorage { return match self.current_storage { cpu(value) => value; else => missing_cpu_storage() } }
    private func gpu_storage() GPUStorage { return match self.current_storage { gpu(value) => value; else => missing_gpu_storage() } }
    private func require_cpu_extraction(extractor:str) {
        if self.is_gpu() { panic("Tensor.$(extractor) is CPU-only; call cpu().$(extractor)") }
    }
    private func require_extraction(dtype:DType, extractor:str) {
        self.require_cpu_extraction(extractor)
        if self.dtype() != dtype {
            panic("Tensor.$(extractor) does not match the tensor dtype; use the matching extractor or cast(dtype)")
        }
    }
    private func same_gpu_or_fail(storage:@GPUStorage, device:@GPU.Device) Tensor {
        if !storage.same_device(device) { panic("Tensor.to cannot migrate between GPU devices; call cpu().to(other_device)") }
        return self
    }
}

func cast_storage(storage:CPUStorage, layout:Layout, dtype:DType) CPUStorage {
    if dtype == DType.float32() { return CPUStorage(cast_values_to<float>(storage, layout)) }
    if dtype == DType.int8() { return CPUStorage(cast_values_to<int8>(storage, layout)) }
    if dtype == DType.uint8() { return CPUStorage(cast_values_to<uint8>(storage, layout)) }
    if dtype == DType.int16() { return CPUStorage(cast_values_to<int16>(storage, layout)) }
    if dtype == DType.uint16() { return CPUStorage(cast_values_to<uint16>(storage, layout)) }
    if dtype == DType.int32() { return CPUStorage(cast_values_to<int32>(storage, layout)) }
    if dtype == DType.uint32() { return CPUStorage(cast_values_to<uint32>(storage, layout)) }
    if dtype == DType.int64() { return CPUStorage(cast_values_to<int64>(storage, layout)) }
    return CPUStorage(cast_values_to<uint64>(storage, layout))
}

func cast_values_to<T>(storage:CPUStorage, layout:Layout) T[] {
    if storage.dtype() == DType.float32() { return cast_values<float, T>(gather_values<float>(storage.float_values(), layout)) }
    if storage.dtype() == DType.int8() { return cast_values<int8, T>(gather_values<int8>(storage.int8_values(), layout)) }
    if storage.dtype() == DType.uint8() { return cast_values<uint8, T>(gather_values<uint8>(storage.uint8_values(), layout)) }
    if storage.dtype() == DType.int16() { return cast_values<int16, T>(gather_values<int16>(storage.int16_values(), layout)) }
    if storage.dtype() == DType.uint16() { return cast_values<uint16, T>(gather_values<uint16>(storage.uint16_values(), layout)) }
    if storage.dtype() == DType.int32() { return cast_values<int32, T>(gather_values<int32>(storage.int32_values(), layout)) }
    if storage.dtype() == DType.uint32() { return cast_values<uint32, T>(gather_values<uint32>(storage.uint32_values(), layout)) }
    if storage.dtype() == DType.int64() { return cast_values<int64, T>(gather_values<int64>(storage.int64_values(), layout)) }
    return cast_values<uint64, T>(gather_values<uint64>(storage.uint64_values(), layout))
}

func cast_values<T, U>(values:T[]) U[] {
    var result:U[] = []
    for value in values { result.append(value as U) }
    return result
}

func missing_cpu_storage() CPUStorage { panic("Tensor is not CPU-resident") }
func missing_gpu_storage() GPUStorage { panic("Tensor is not GPU-resident") }
func only_item<T>(values:T[], extractor:str) T {
    if values.count() != 1 { panic("Tensor.$(extractor) requires exactly one element") }
    return values[0]
}
func require_element_count(shape:int[], count:int, width:int) {
    if shape_product(shape) != count { panic("Tensor values must match the declared shape") }
    let physical_size = checked_byte_count(count, width)
}
func vector_shape(count:int) int[] { return [count] }
func matrix_shape(rows:int, columns:int) int[] { return [rows, columns] }
