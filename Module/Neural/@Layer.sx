use GFX.GPU
use Tensor
use Package.ForwardBuilder
use Package.PreparedForward
use Package.forward_example_supported

class LayerState {
    var layers:Layer[]
    var parameters:Parameter[]
    var buffers:Buffer[]
    init() { self.layers = []; self.parameters = []; self.buffers = [] }

    func add_parameter(parameter:Parameter) {
        for existing in self.parameters {
            if existing == parameter { return }
            if existing.name() == parameter.name() { panic("Tensor.Neural.Layer duplicate state name '$(parameter.name())'") }
        }
        for buffer in self.buffers {
            if buffer.name() == parameter.name() { panic("Tensor.Neural.Layer duplicate state name '$(parameter.name())'") }
        }
        self.parameters.append(parameter)
    }
    func add_buffer(buffer:Buffer) {
        for existing in self.buffers {
            if existing == buffer { return }
            if existing.name() == buffer.name() { panic("Tensor.Neural.Layer duplicate state name '$(buffer.name())'") }
        }
        for parameter in self.parameters {
            if parameter.name() == buffer.name() { panic("Tensor.Neural.Layer duplicate state name '$(buffer.name())'") }
        }
        self.buffers.append(buffer)
    }
}

public nocopy class Layer {
    private var own_parameters:Parameter[]
    private var own_buffers:Buffer[]
    private var child_names:str[]
    private var child_layers:Layer[]
    private var current_training:bool
    private var prepared_forward:PreparedForward?=null
    private var forward_preparations:int=0
    private var forward_rejections:int=0
    private var forward_captures:int=0
    private var forward_compilations:int=0
    private var forward_executions:int=0
    private var forward_fallbacks:int=0
    private var forward_last_fallback:str=""

    protected init() {
        self.own_parameters = []
        self.own_buffers = []
        self.child_names = []
        self.child_layers = []
        self.current_training = true
    }

    protected func register_parameter(parameter:Parameter) {
        var state = self.collect_state()
        state.add_parameter(parameter)
        for existing in self.own_parameters { if existing == parameter { return } }
        self.own_parameters.append(parameter)
    }

    protected func register_buffer(buffer:Buffer) {
        var state = self.collect_state()
        state.add_buffer(buffer)
        for existing in self.own_buffers { if existing == buffer { return } }
        self.own_buffers.append(buffer)
    }

    protected func register_child(name:str, child:Layer) {
        if name == "" { panic("Tensor.Neural.Layer requires a non-empty child name") }
        var index = 0
        while index < self.child_names.count() {
            if self.child_names[index] == name {
                if self.child_layers[index] == child { return }
                panic("Tensor.Neural.Layer duplicate child name '$(name)'")
            }
            index++
        }
        if child.reaches(self,[]) { panic("Tensor.Neural.Layer cannot register a cycle") }
        var state = self.collect_state()
        for parameter in child.parameters() { state.add_parameter(parameter) }
        for buffer in child.buffers() { state.add_buffer(buffer) }
        self.child_names.append(name)
        self.child_layers.append(child)
    }

    func children() Layer[] {
        var result:Layer[] = []
        for child in self.child_layers {
            var found = false
            for existing in result { if existing == child { found = true } }
            if !found { result.append(child) }
        }
        return result
    }

    func child(name:str) Layer? {
        var index = 0
        while index < self.child_names.count() {
            if self.child_names[index] == name { return self.child_layers[index] }
            index++
        }
        return null
    }

    func forward(input:Tensor) Tensor {
        panic("Tensor.Neural.Layer.forward must be implemented by a concrete layer")
    }
    func parameters() Parameter[] {
        if !self.has_registration() { return [] }
        return self.collect_state().parameters
    }
    func buffers() Buffer[] {
        if !self.has_registration() { return [] }
        return self.collect_state().buffers
    }
    func is_training() bool { return self.current_training }

    func prepare_forward(example:Tensor) Result<void,str> { return Layer.prepare_owned_forward(self,example) }
    func clear_forward_plan() { Layer.clear_owned_forward(self) }
    func forward_plan_statistics() ForwardPlanStatistics { return Layer.owned_forward_statistics(self) }

    module static func prepare_owned_forward(model:Layer,example:Tensor) Result<void,str> {
        model.forward_preparations++
        var visited:Layer[]=[]
        match forward_preflight(model,visited) {
            failure(reason)=>{model.forward_rejections++;return Result<void,str>.failure(reason)}
            success=>{}
        }
        if !forward_example_supported(example) {
            model.forward_rejections++
            return Result<void,str>.failure("Tensor prepared forward requires a nonempty GPU float32 input of rank at most 5")
        }
        if var plan=model.prepared_forward {
            var values:Tensor[]=[]
            if plan.incompatibility(example,model.current_training,values)=="" { return Result<void,str>.success() }
        }
        var builder=ForwardBuilder(example)
        match model.describe_forward(builder) {
            failure(reason)=>{model.forward_rejections++;return Result<void,str>.failure(reason)}
            success=>{}
        }
        var plan=builder.finish(example,model.current_training)
        model.prepared_forward=plan
        model.forward_captures++
        model.forward_compilations++
        model.forward_last_fallback=""
        return Result<void,str>.success()
    }

    module static func capture_training_forward(model:Layer,example:Tensor) Result<PreparedForward,str> {
        var visited:Layer[]=[]
        try forward_preflight(model,visited)
        if !forward_example_supported(example) {
            return Result<PreparedForward,str>.failure("Tensor prepared training requires a nonempty GPU float32 input of rank at most 5")
        }
        var builder=ForwardBuilder(example)
        try model.describe_forward(builder)
        return Result<PreparedForward,str>.success(builder.finish(example,model.current_training))
    }

    module static func clear_owned_forward(model:Layer) { model.prepared_forward=null }

    module static func owned_forward_statistics(model:Layer) ForwardPlanStatistics {
        var cached=0
        var operations=0
        if var plan=model.prepared_forward {cached=1;operations=plan.operation_count()}
        return ForwardPlanStatistics(preparations:model.forward_preparations,rejections:model.forward_rejections,
            captures:model.forward_captures,compilations:model.forward_compilations,executions:model.forward_executions,
            fallbacks:model.forward_fallbacks,cached_plans:cached,prepared_operations:operations,last_fallback:model.forward_last_fallback)
    }

    module static func run_owned_forward(model:Layer,input:Tensor) Tensor? {
        if var plan=model.prepared_forward {
            var parameters:Tensor[]=[]
            let reason=plan.incompatibility(input,model.current_training,parameters)
            if reason=="" {
                let result=plan.run(input,parameters)
                model.forward_executions++
                model.forward_last_fallback=""
                return result
            }
            model.forward_fallbacks++
            model.forward_last_fallback=reason
        }
        return null
    }

    package func describe_forward(builder:ForwardBuilder) Result<void,str> {
        return Result<void,str>.failure("Tensor prepared forward requires a supported concrete layer")
    }
    func train() { self.set_training(true) }
    func eval() { self.set_training(false) }
    func freeze() { self.set_trainable(false) }
    func unfreeze() { self.set_trainable(true) }
    func zero_grad() {
        var parameters = self.parameters()
        for var parameter in parameters { parameter.zero_grad() }
    }

    func to(device:GPU.Device) {
        var state = self.collect_state()
        self.require_transfer_gradients(state,"to")
        for parameter in state.parameters { parameter.value().require_transfer_device(device) }
        for buffer in state.buffers {
            if buffer.placement_policy() == BufferPlacement.model { buffer.value().require_transfer_device(device) }
        }
        var parameters = state.parameters
        for var parameter in parameters { parameter.to(device) }
        var buffers = state.buffers
        for var buffer in buffers {
            if buffer.placement_policy() == BufferPlacement.model { buffer.to(device) }
        }
        var layers = state.layers
        for var layer in layers {
            if layer != self && !layer.has_registration() { layer.to(device) }
            else { layer.moved_to(device) }
        }
    }
    func cpu() {
        var state = self.collect_state()
        self.require_transfer_gradients(state,"cpu")
        var parameters = state.parameters
        for var parameter in parameters { parameter.cpu() }
        var buffers = state.buffers
        for var buffer in buffers { buffer.cpu() }
        var layers = state.layers
        for var layer in layers {
            if layer != self && !layer.has_registration() { layer.cpu() }
            else { layer.moved_to_cpu() }
        }
    }

    protected func training_changed(training:bool) {}
    protected func moved_to(device:GPU.Device) {}
    protected func moved_to_cpu() {}

    package func checkpoint_configuration() str {return ""}
    package func checkpoint_random_state() str {return ""}
    package func checkpoint_validate_random_state(value:str) Result<void,str> {
        if value!="" {return Result<void,str>.failure("Tensor.Neural.TrainingCheckpoint contains unexpected layer state")}
        return Result<void,str>.success()
    }
    package func checkpoint_apply_random_state(value:str) {}
    package func checkpoint_validate_buffers(entries:TrainingTensorState[]) Result<void,str> {return Result<void,str>.success()}

    package func checkpoint_restore_local(training:bool,random_state:str) {
        self.current_training=training
        self.checkpoint_apply_random_state(random_state)
        self.training_changed(training)
    }

    package func checkpoint_nodes() TrainingNode[] {
        var state=self.collect_state();var nodes:TrainingNode[]=[]
        for layer in state.layers {
            var signature=layer.checkpoint_configuration()+"|parameters"
            for parameter in layer.own_parameters {signature+="|"+checkpoint_name(parameter.name())}
            signature+="|buffers"
            for buffer in layer.own_buffers {signature+="|"+checkpoint_name(buffer.name())}
            signature+="|children"
            var index=0
            while index<layer.child_layers.count() {
                var target=0
                while state.layers[target]!=layer.child_layers[index] {target++}
                signature+="|"+checkpoint_name(layer.child_names[index])+":$(target)"
                index++
            }
            nodes.append(TrainingNode(layer:layer,signature:signature))
        }
        return nodes
    }

    private func set_training(training:bool) {
        var state = self.collect_state()
        var layers = state.layers
        for var layer in layers {
            layer.current_training = training
            if layer != self && !layer.has_registration() {
                if training { layer.train() } else { layer.eval() }
            } else { layer.training_changed(training) }
        }
    }
    private func set_trainable(trainable:bool) {
        var parameters = self.parameters()
        for parameter in parameters {
            if parameter.is_trainable() != trainable && parameter.gradient() != null {
                panic("Tensor.Neural.Layer requires zero_grad before changing trainability")
            }
        }
        for var parameter in parameters {
            if trainable { parameter.unfreeze() } else { parameter.freeze() }
        }
    }
    private func require_transfer_gradients(state:LayerState, operation:str) {
        for parameter in state.parameters {
            if parameter.gradient() != null { panic("Tensor.Neural.Layer.$(operation) requires zero_grad before changing placement") }
        }
    }

    private func has_registration() bool {
        return !self.own_parameters.is_empty() || !self.own_buffers.is_empty() || !self.child_layers.is_empty()
    }

    private func collect_state() LayerState {
        var state = LayerState()
        self.append_state(state,true)
        return state
    }

    private func append_state(state:LayerState, root:bool) {
        var collected = state
        for visited in collected.layers { if visited == self { return } }
        collected.layers.append(self)
        if !root && !self.has_registration() {
            for parameter in self.parameters() { collected.add_parameter(parameter) }
            for buffer in self.buffers() { collected.add_buffer(buffer) }
            return
        }
        for parameter in self.own_parameters { collected.add_parameter(parameter) }
        for buffer in self.own_buffers { collected.add_buffer(buffer) }
        for child in self.child_layers { child.append_state(collected,false) }
    }

    private func reaches(target:Layer, visited:Layer[]) bool {
        if self == target { return true }
        for previous in visited { if previous == self { return false } }
        var next = visited
        next.append(self)
        for child in self.child_layers { if child.reaches(target,next) { return true } }
        return false
    }
}
