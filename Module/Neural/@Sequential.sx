use GFX.GPU
use Tensor

public nocopy class Sequential:Layer {
    private var layers:Layer[]

    init(layers:Layer[]) {
        if layers.is_empty() { panic("Tensor.Neural.Sequential requires at least one layer") }
        self.layers = layers
        var index = 0
        for layer in layers {
            self.register_child("layer$(index)",layer)
            index++
        }
    }

    override func forward(input:Tensor) Tensor {
        var result = input
        var layers = self.layers
        for var layer in layers { result = layer.forward(result) }
        return result
    }

}
