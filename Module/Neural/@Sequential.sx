use GFX.GPU
use Tensor

public nocopy class Sequential:Layer {
    private var layers:Layer[]

    init(layers:Layer[]) {
        if layers.is_empty() { panic("Tensor.Neural.Sequential requires at least one layer") }
        self.layers = layers
        var parameters = self.parameters()
        var index = 0
        while index < parameters.count() {
            var previous = 0
            while previous < index {
                if parameters[previous].name() == parameters[index].name() {
                    panic("Tensor.Neural.Sequential requires unique parameter names; duplicate '$(parameters[index].name())'")
                }
                previous++
            }
            index++
        }
    }

    override func forward(input:Tensor) Tensor {
        var result = input
        var layers = self.layers
        for var layer in layers { result = layer.forward(result) }
        return result
    }

    override func parameters() Parameter[] {
        var result:Parameter[] = []
        var layers = self.layers
        for var layer in layers {
            var parameters = layer.parameters()
            for parameter in parameters { result.append(parameter) }
        }
        return result
    }

    override func train() {
        var layers = self.layers
        for var layer in layers { layer.train() }
    }
    override func eval() {
        var layers = self.layers
        for var layer in layers { layer.eval() }
    }
    override func to(device:GPU.Device) {
        var layers = self.layers
        for var layer in layers { layer.to(device) }
    }
    override func cpu() {
        var layers = self.layers
        for var layer in layers { layer.cpu() }
    }
}
