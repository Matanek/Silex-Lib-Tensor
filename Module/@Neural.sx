use STD.Math

extend Tensor {
    func softmax(axis:int) Tensor {
        require_neural_float(self, "softmax")
        require_axis(axis, self.rank(), "softmax")
        let maximum = self.max([axis], true)
        let shifted = self.subtract(maximum)
        let exponentials = shifted.exp()
        return exponentials.divide(exponentials.sum([axis], true))
    }

    func masked_softmax(mask:Tensor, axis:int) Tensor {
        require_neural_float(self, "masked_softmax")
        require_axis(axis, self.rank(), "masked_softmax")
        if !mask.dtype().is_boolean() {panic("Tensor.masked_softmax mask requires dtype boolean")}
        if mask.is_cpu()!=self.is_cpu() {panic("Tensor.masked_softmax requires matching placements")}
        if !mask.has_same_placement(self) {panic("Tensor.masked_softmax requires tensors on the same GPU device")}
        let broadcasted=broadcast_shape(self.shape(),mask.shape(),"masked_softmax")
        if !shapes_equal(broadcasted,self.shape()) {panic("Tensor.masked_softmax mask must broadcast to the input shape")}
        let visible=mask.expand(self.shape())
        if self.count()==0 {return self.multiply(0.0)}
        let zero=self.autograd_constant(0.0)
        let one=self.autograd_constant(1.0)
        let present=Tensor.where(visible,one,zero).sum([axis],true).greater_than(0.0)
        // Exclude values before arithmetic, and detach the translation of each row.
        let masked=Tensor.where(visible,self.detach(),self.autograd_constant(Math.log(0.0)))
        let maximum=masked.max([axis],true)
        let safe_maximum=Tensor.where(present,maximum,maximum.autograd_constant(0.0))
        let valid_scores=Tensor.where(visible,self,zero)
        let shifted=Tensor.where(visible,valid_scores.subtract(safe_maximum),zero)
        let exponentials=Tensor.where(visible,shifted.exp(),zero)
        let total=exponentials.sum([axis],true)
        let denominator=Tensor.where(present,total,total.autograd_constant(1.0))
        return exponentials.divide(denominator)
    }

    func log_softmax(axis:int) Tensor {
        require_neural_float(self, "log_softmax")
        require_axis(axis, self.rank(), "log_softmax")
        let maximum = self.max([axis], true)
        let shifted = self.subtract(maximum)
        return shifted.subtract(shifted.exp().sum([axis], true).log())
    }

    func layer_norm(dimensions:int = 1, epsilon:float = 0.00001) Tensor {
        require_neural_float(self, "layer_norm")
        if dimensions <= 0 || dimensions > self.rank() {
            panic("Tensor.layer_norm dimensions must select one or more trailing axes")
        }
        if epsilon <= 0.0 { panic("Tensor.layer_norm epsilon must be positive") }
        var axes:int[] = []
        var axis = self.rank() - dimensions
        while axis < self.rank() { axes.append(axis); axis++ }
        let mean = self.mean(axes, true)
        let centered = self.subtract(mean)
        let variance = centered.multiply(centered).mean(axes, true)
        return centered.divide(variance.add(epsilon).sqrt())
    }

    func mse_loss(target:Tensor) Tensor {
        require_neural_float(self, "mse_loss")
        let difference = self.subtract(target)
        return difference.multiply(difference).mean()
    }

    func cross_entropy(target:Tensor, axis:int) Tensor {
        require_neural_float(self, "cross_entropy")
        require_axis(axis, self.rank(), "cross_entropy")
        if target.dtype() == DType.float32() {
            if !shapes_equal(self.shape(), target.shape()) {
                panic("Tensor.cross_entropy dense targets must have the same shape as the logits")
            }
            return self.log_softmax(axis).multiply(target).sum([axis]).negate().mean()
        }
        if target.dtype() == DType.int32() {
            return self.log_softmax(axis).gather(axis, target).negate().mean()
        }
        panic("Tensor.cross_entropy targets must use dtype float32 or int32")
    }
}

func require_neural_float(tensor:Tensor, operation:str) {
    if tensor.dtype() != DType.float32() {
        panic("Tensor.$(operation) supports only dtype float32; call cast(DType.float32())")
    }
}
