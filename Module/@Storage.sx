    func pooling_backward(
        input:GPUStorage, gradient_layout:Layout, input_layout:Layout,
        output_layout:Layout, kernel_size:int, stride:int,
        padding:int, operation:PoolOperation
    ) GPUStorage {
        let count = input_layout.count()
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var metadata = pooling_gradient_metadata(
            gradient_layout, input_layout, output_layout,
            kernel_size, stride, padding, operation
        )
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 pooling gradient result"
        )
        var pipeline = self.kernel_cache.pooling_gradient()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        self.kernel_cache.profile_state.compute_pass()
        compute.bind(pipeline)
        self.kernel_cache.profile_state.bind_pipeline()
        compute.storage_buffer(0, self.required_buffer())
        compute.storage_buffer(1, input.required_buffer())
        compute.dispatch(count)
        self.kernel_cache.profile_state.dispatch()
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        self.kernel_cache.profile_state.submit()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, input, self.current_dtype, count)
    }

    func dropout(layout:Layout, probability:float, seed:int, iteration:int) GPUStorage {
        let count = layout.count()
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var metadata = elementwise_metadata(0, layout)
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 dropout result"
        )
        var pipeline = self.kernel_cache.dropout()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        commands.compute_uniform(1, probability)
        commands.compute_uniform(2, 1.0 / (1.0 - probability))
        var counter_words:uint32[] = [seed as uint32, iteration as uint32]
        var counter_bytes = uint32_bytes(counter_words)
        commands.compute_uniform(3, @counter_bytes[0:counter_bytes.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        self.kernel_cache.profile_state.compute_pass()
        compute.bind(pipeline)
        self.kernel_cache.profile_state.bind_pipeline()
        compute.storage_buffer(0, self.required_buffer())
        compute.dispatch(count)
        self.kernel_cache.profile_state.dispatch()
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        self.kernel_cache.profile_state.submit()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, count)
    }

    private static func empty(device:GPU.Device, dtype:DType) GPUStorage {
        var cache = GPUKernelCache(device)
        return GPUStorage.empty(device, cache, dtype)
    }

    private static func empty(device:GPU.Device, cache:GPUKernelCache, dtype:DType) GPUStorage {
        var buffer = GPUStorage.allocate_buffer(device, 4, "Tensor empty storage",dtype)
        return GPUStorage(device, cache, buffer, null, null, null, null, dtype, 0)
    }

    private static func finish_upload(device:GPU.Device, upload:GPU.TransferBuffer, dtype:DType, count:int) GPUStorage {
        let byte_count = checked_byte_count(count, dtype.byte_width())
        GPUPerformanceCounters.record_upload_staging()
        var profile_state = GPUProfileRegistry.state(device)
        profile_state.upload(byte_count)
        var buffer = GPUStorage.allocate_buffer(device, storage_buffer_bytes(byte_count, dtype), "Tensor storage",dtype)
        var commands = device.commands()
        var transfer = commands.copy()
        transfer.upload(upload, buffer, byte_count)
        transfer.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        profile_state.submit()
        return GPUStorage(device, GPUKernelCache(device), buffer, upload, completed, null, null, dtype, count)
    }

    private static func allocate_buffer(device:GPU.Device, size:int, name:str, dtype:DType = DType.float32()) GPU.Buffer {
        return GPUProfileRegistry.state(device).acquire_buffer(size,dtype,name)
    }

    private func required_buffer() GPU.Buffer {
        if var fence = self.completion {
            if fence.is_ready() {
                self.completion = null
                self.upload_buffer = null
                self.parent = null
                self.other_parent = null
                self.third_parent = null
            }
        }
        if var buffer = self.current_buffer { return buffer }
        panic("Tensor empty GPU storage has no buffer")
    }
}

func elementwise_metadata(operation:int, layout:Layout) uint8[] {
    require_gpu_layout(layout)
    var words:uint32[] = []
    words.append(operation as uint32)
    words.append(layout.count() as uint32)
    words.append(layout.rank() as uint32)
    words.append(layout.offset() as uint32)
    append_padded_shape(words, layout.shape())
    append_padded_strides(words, layout.strides(), layout.shape(), layout.rank())
    while words.count() < 16 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func binary_metadata(
    operation:int,
    output_shape:int[],
    left:Layout,
    right:Layout
) uint8[] {
    if output_shape.count() > 5 { panic("Tensor GPU broadcasting supports ranks up to 5") }
    require_gpu_layout(left)
    require_gpu_layout(right)
    let count = shape_product(output_shape)
    require_gpu_uint32(count, "element count")
    var words:uint32[] = []
    words.append(operation as uint32)
    words.append(count as uint32)
    words.append(output_shape.count() as uint32)
    words.append(left.offset() as uint32)
    words.append(right.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    append_padded_shape(words, output_shape)
    while words.count() < 16 { words.append(0 as uint32) }
    append_padded_broadcast_strides(words, left, output_shape.count())
    while words.count() < 24 { words.append(0 as uint32) }
    append_padded_broadcast_strides(words, right, output_shape.count())
    while words.count() < 32 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func topk_metadata(layout:Layout, k:int, axis:int, largest:bool, groups:int) uint8[] {
    let inner = trailing_product(layout.shape(),axis+1)
    require_gpu_uint32(groups,"top-k group count")
    require_gpu_uint32(inner,"top-k inner count")
    var words:uint32[] = []
    if largest { words.append(1 as uint32) }
    else { words.append(0 as uint32) }
    words.append(axis as uint32)
    words.append(layout.rank() as uint32)
    words.append(groups as uint32)
    words.append(layout.shape()[axis] as uint32)
    words.append(layout.offset() as uint32)
    words.append(k as uint32)
    words.append(inner as uint32)
    append_padded_shape(words,layout.shape())
    while words.count() < 16 { words.append(1 as uint32) }
    append_padded_strides(words,layout.strides(),layout.shape(),layout.rank())
    while words.count() < 24 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func reduction_metadata(
    operation:ReductionOperation,
    layout:Layout,
    axes:int[],
    keep_dimensions:bool,
    output_count:int
) uint8[] {
    require_gpu_layout(layout)
    require_gpu_uint32(output_count, "reduction output count")
    let domain_count = reduction_domain_size(layout.shape(), axes)
    require_gpu_uint32(domain_count, "reduction domain count")
    let reduced = reduction_mask(layout.rank(), axes)
    var words:uint32[] = []
    words.append(reduction_code(operation) as uint32)
    words.append(layout.count() as uint32)
    words.append(layout.rank() as uint32)
    words.append(output_count as uint32)
    words.append(domain_count as uint32)
    words.append(layout.offset() as uint32)
    if keep_dimensions { words.append(1 as uint32) }
    else { words.append(0 as uint32) }
    words.append(0 as uint32)
    append_padded_shape(words, layout.shape())
    while words.count() < 16 { words.append(1 as uint32) }
    append_padded_strides(words, layout.strides(), layout.shape(), layout.rank())
    while words.count() < 24 { words.append(0 as uint32) }
    var axis = 0
    while axis < layout.rank() {
        if reduced[axis] { words.append(1 as uint32) }
        else { words.append(0 as uint32) }
        axis++
    }
    while words.count() < 32 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func linear_metadata(
    left:Layout,
    right:Layout,
    operation:LinearOperation,
    output_count:int
) uint8[] {
    require_gpu_layout(left)
    require_gpu_layout(right)
    require_gpu_uint32(output_count, "linear output count")
    let (rows, columns, shared) = linear_dimensions(left, right, operation)
    require_gpu_uint32(rows, "linear row count")
    require_gpu_uint32(columns, "linear column count")
    require_gpu_uint32(shared, "linear inner dimension")
    var batch_rank = 0
    if operation == LinearOperation.matrix_multiply { batch_rank = output_count_rank(left, right) }
    var words:uint32[] = []
    words.append(rows as uint32)
    words.append(columns as uint32)
    words.append(shared as uint32)
    words.append(output_count as uint32)
    words.append(batch_rank as uint32)
    words.append(left.rank() as uint32)
    words.append(right.rank() as uint32)
    if operation == LinearOperation.dot { words.append(1 as uint32) }
    else { words.append(0 as uint32) }
    words.append(left.offset() as uint32)
    words.append(right.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    var output_batch:int[] = []
    var axis = 0
    while axis < batch_rank {
        let left_axis = axis - (batch_rank - (left.rank() - 2))
        let right_axis = axis - (batch_rank - (right.rank() - 2))
        var dimension = 1
        if left_axis >= 0 { dimension = left.shape()[left_axis] }
        if right_axis >= 0 && right.shape()[right_axis] > dimension { dimension = right.shape()[right_axis] }
        output_batch.append(dimension)
        axis++
    }
    append_padded_shape(words, output_batch)
    append_padded_shape(words, left.shape())
    append_padded_strides(words, left.strides(), left.shape(), left.rank())
    append_padded_shape(words, right.shape())
    append_padded_strides(words, right.strides(), right.shape(), right.rank())
    return uint32_bytes(words)
}

func output_count_rank(left:Layout, right:Layout) int {
    var rank = left.rank() - 2
    if right.rank() - 2 > rank { rank = right.rank() - 2 }
    return rank
}

func gather_metadata(source:Layout, indices:Layout, axis:int, padding_index:int = -1) uint8[] {
    require_gpu_layout(source)
    require_gpu_layout(indices)
    var words:uint32[] = []
    words.append(indices.count() as uint32)
    words.append(source.rank() as uint32)
    words.append(axis as uint32)
    words.append(source.offset() as uint32)
    words.append(indices.rank() as uint32)
    words.append(indices.offset() as uint32)
    words.append(source.shape()[axis] as uint32)
    words.append((padding_index + 1) as uint32)
    append_padded_shape(words, source.shape())
    append_padded_strides(words, source.strides(), source.shape(), source.rank())
    append_padded_shape(words, indices.shape())
    append_padded_strides(words, indices.strides(), indices.shape(), indices.rank())
    return uint32_bytes(words)
}

func convolution_metadata(
    input:Layout, kernel:Layout, output_shape:int[], stride:int, padding:int
) uint8[] {
    require_gpu_layout(input)
    require_gpu_layout(kernel)
    var words:uint32[] = []
    words.append(shape_product(output_shape) as uint32)
    words.append(stride as uint32)
    words.append(padding as uint32)
    words.append(input.offset() as uint32)
    words.append(kernel.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    for value in input.shape() { words.append(value as uint32) }
    for value in input.strides() { words.append(value as uint32) }
    for value in kernel.shape() { words.append(value as uint32) }
    for value in kernel.strides() { words.append(value as uint32) }
    for value in output_shape { words.append(value as uint32) }
    return uint32_bytes(words)
}

func convolution_gradient_metadata(
    gradient:Layout, other:Layout, result:Layout,
    stride:int, padding:int, mode:int
) uint8[] {
    require_gpu_layout(gradient)
    require_gpu_layout(other)
    require_gpu_layout(result)
    var words:uint32[] = []
    words.append(result.count() as uint32)
    words.append(mode as uint32)
    words.append(stride as uint32)
    words.append(padding as uint32)
    words.append(gradient.offset() as uint32)
    words.append(other.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    for value in gradient.shape() { words.append(value as uint32) }
    for value in gradient.strides() { words.append(value as uint32) }
    for value in other.shape() { words.append(value as uint32) }
    for value in other.strides() { words.append(value as uint32) }
    for value in result.shape() { words.append(value as uint32) }
    return uint32_bytes(words)
}

func pooling_metadata(
    input:Layout, output_shape:int[], kernel_size:int, stride:int,
    padding:int, operation:PoolOperation
) uint8[] {
    require_gpu_layout(input)
    var words:uint32[] = []
    words.append(shape_product(output_shape) as uint32)
    words.append(kernel_size as uint32)
    words.append(stride as uint32)
    words.append(padding as uint32)
    if operation == PoolOperation.maximum { words.append(0 as uint32) }
    else { words.append(1 as uint32) }
    words.append(input.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    for value in input.shape() { words.append(value as uint32) }
    for value in input.strides() { words.append(value as uint32) }
    for value in output_shape { words.append(value as uint32) }
    return uint32_bytes(words)
}

func pooling_gradient_metadata(
    gradient:Layout, input:Layout, output:Layout,
    kernel_size:int, stride:int, padding:int, operation:PoolOperation
) uint8[] {
    require_gpu_layout(gradient)
    require_gpu_layout(input)
    var words:uint32[] = []
    words.append(input.count() as uint32)
    words.append(kernel_size as uint32)
    words.append(stride as uint32)
    words.append(padding as uint32)
    if operation == PoolOperation.maximum { words.append(0 as uint32) }
    else { words.append(1 as uint32) }
    words.append(gradient.offset() as uint32)
    words.append(input.offset() as uint32)
    words.append(0 as uint32)
    for value in gradient.shape() { words.append(value as uint32) }
    for value in gradient.strides() { words.append(value as uint32) }
    for value in input.shape() { words.append(value as uint32) }
    for value in input.strides() { words.append(value as uint32) }
    for value in output.shape() { words.append(value as uint32) }
    return uint32_bytes(words)
}

func reduction_code(operation:ReductionOperation) int {
    return match operation { sum => 0; mean => 1; minimum => 2; maximum => 3 }
}

func require_gpu_layout(layout:Layout) {
    if layout.rank() > 5 { panic("Tensor GPU computation supports ranks up to 5") }
    require_gpu_uint32(layout.count(), "element count")
    require_gpu_uint32(layout.offset(), "layout offset")
    for dimension in layout.shape() { require_gpu_uint32(dimension, "shape dimension") }
    for stride in layout.strides() { require_gpu_uint32(stride, "layout stride") }
}

func require_gpu_uint32(value:int, subject:str) {
    if value < 0 || value > 4294967295 { panic("Tensor GPU $(subject) exceeds uint32") }
}

func append_padded_shape(words:&uint32[], shape:int[]) {
    for value in shape { words.append(value as uint32) }
    var axis = shape.count()
    while axis < 8 { words.append(1 as uint32); axis++ }
}

func append_padded_strides(words:&uint32[], strides:int[], shape:int[], rank:int) {
    var axis = 0
    while axis < rank {
        if shape[axis] == 1 { words.append(0 as uint32) }
        else { words.append(strides[axis] as uint32) }
        axis++
    }
    while axis < 8 { words.append(0 as uint32); axis++ }
}

func append_padded_broadcast_strides(words:&uint32[], layout:Layout, output_rank:int) {
    let shape = layout.shape()
    let strides = layout.strides()
    let missing = output_rank - layout.rank()
    var axis = 0
    while axis < output_rank {
        let input_axis = axis - missing
        if input_axis < 0 || shape[input_axis] == 1 { words.append(0 as uint32) }
        else { words.append(strides[input_axis] as uint32) }
        axis++
    }
}

func uint32_bytes(words:uint32[]) uint8[] {
    var bytes:uint8[] = []
    for word in words {
        bytes.append((word & 255) as uint8)
        bytes.append(((word >> 8) & 255) as uint8)
        bytes.append(((word >> 16) & 255) as uint8)
        bytes.append(((word >> 24) & 255) as uint8)
    }
    return bytes
}

func gather_values<T>(values:T[], layout:Layout) T[] {
    var result:T[] = []
    var logical = 0
    while logical < layout.count() {
        result.append(values[layout.flat_storage_index(logical)])
        logical++
    }
    return result
}

func storage_mismatch<T>() T[] { panic("Tensor internal storage dtype mismatch") }

func gpu_byte_count(logical_count:int) int {
    if logical_count < 4 { return 4 }
    return logical_count
}

func boolean_buffer_bytes(count:int) int {
    var words = count / 4
    if count % 4 != 0 { words++ }
    let bytes = gpu_byte_count(checked_byte_count(words, 4))
    require_gpu_uint32(bytes, "boolean buffer byte size")
    return bytes
}
func storage_buffer_bytes(bytes:int, dtype:DType) int {
    if dtype.is_boolean() { return boolean_buffer_bytes(bytes) }
    return gpu_byte_count(bytes)
}

func mask_metadata(operation:int, shape:int[], left:Layout, right:Layout, third:Layout, boolean_input:bool, scalar_input:bool) uint8[] {
    if shape.count() > 5 { panic("Tensor GPU broadcasting supports ranks up to 5") }
    require_gpu_layout(left)
    require_gpu_layout(right)
    require_gpu_layout(third)
    let count = shape_product(shape)
    require_gpu_uint32(count, "element count")
    var words:uint32[] = [operation as uint32, count as uint32, shape.count() as uint32, left.offset() as uint32,
        right.offset() as uint32, third.offset() as uint32]
    if boolean_input { words.append(1 as uint32) } else { words.append(0 as uint32) }
    if scalar_input { words.append(1 as uint32) } else { words.append(0 as uint32) }
    append_padded_shape(words, shape)
    append_padded_broadcast_strides(words, left, shape.count())
    while words.count() < 24 { words.append(0 as uint32) }
    append_padded_broadcast_strides(words, right, shape.count())
    while words.count() < 32 { words.append(0 as uint32) }
    append_padded_broadcast_strides(words, third, shape.count())
    while words.count() < 40 { words.append(0 as uint32) }
    return uint32_bytes(words)
}
