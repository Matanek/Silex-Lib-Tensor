    func concatenate(
        other:GPUStorage,
        left_layout:Layout,
        right_layout:Layout,
        axis:int
    ) GPUStorage {
        let count = left_layout.count() + right_layout.count()
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        let width = self.current_dtype.byte_width()
        let inner = trailing_product(left_layout.shape(), axis + 1)
        let left_block = checked_product(left_layout.shape()[axis], inner, "Tensor concatenate block size overflows int")
        let right_block = checked_product(right_layout.shape()[axis], inner, "Tensor concatenate block size overflows int")
        let block = left_block + right_block
        var output = GPUStorage.allocate_buffer(
            self.current_device,
            storage_buffer_bytes(checked_byte_count(count, width), self.current_dtype),
            "Tensor concatenated storage", self.current_dtype
        )
        var commands = self.current_device.commands()
        var transfer = commands.copy()
        var logical = 0
        while logical < count {
            let within = logical % block
            let outer = logical / block
            if within < left_block {
                transfer.copy(
                    self.required_buffer(), output, width,
                    layout:checked_byte_count(left_layout.flat_storage_index(outer * left_block + within), width),
                    offset:checked_byte_count(logical, width), cycle:false
                )
            } else {
                transfer.copy(
                    other.required_buffer(), output, width,
                    layout:checked_byte_count(right_layout.flat_storage_index(outer * right_block + within - left_block), width),
                    offset:checked_byte_count(logical, width), cycle:false
                )
            }
            logical++
        }
        transfer.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        self.kernel_cache.profile_state.submit()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, other, self.current_dtype, count)
    }

