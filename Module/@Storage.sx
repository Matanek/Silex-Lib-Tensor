use GFX.GPU

enum CPUValues {
    floats(float[])
    signed8(int8[])
    unsigned8(uint8[])
    signed16(int16[])
    unsigned16(uint16[])
    signed32(int32[])
    unsigned32(uint32[])
    signed64(int64[])
    unsigned64(uint64[])
}

class CPUStorage {
    private let current_values:CPUValues

    init(values:float[]) { self.current_values = CPUValues.floats(values) }
    init(values:int8[]) { self.current_values = CPUValues.signed8(values) }
    init(values:uint8[]) { self.current_values = CPUValues.unsigned8(values) }
    init(values:int16[]) { self.current_values = CPUValues.signed16(values) }
    init(values:uint16[]) { self.current_values = CPUValues.unsigned16(values) }
    init(values:int32[]) { self.current_values = CPUValues.signed32(values) }
    init(values:uint32[]) { self.current_values = CPUValues.unsigned32(values) }
    init(values:int64[]) { self.current_values = CPUValues.signed64(values) }
    init(values:uint64[]) { self.current_values = CPUValues.unsigned64(values) }
    private init(values:CPUValues) { self.current_values = values }

    func dtype() DType {
        return match self.current_values {
            floats(values) => DType.float32()
            signed8(values) => DType.int8()
            unsigned8(values) => DType.uint8()
            signed16(values) => DType.int16()
            unsigned16(values) => DType.uint16()
            signed32(values) => DType.int32()
            unsigned32(values) => DType.uint32()
            signed64(values) => DType.int64()
            unsigned64(values) => DType.uint64()
        }
    }

    func count() int {
        return match self.current_values {
            floats(values) => values.count()
            signed8(values) => values.count()
            unsigned8(values) => values.count()
            signed16(values) => values.count()
            unsigned16(values) => values.count()
            signed32(values) => values.count()
            unsigned32(values) => values.count()
            signed64(values) => values.count()
            unsigned64(values) => values.count()
        }
    }

    func float_values() float[] { return match self.current_values { floats(values) => values; else => storage_mismatch<float>() } }
    func int8_values() int8[] { return match self.current_values { signed8(values) => values; else => storage_mismatch<int8>() } }
    func uint8_values() uint8[] { return match self.current_values { unsigned8(values) => values; else => storage_mismatch<uint8>() } }
    func int16_values() int16[] { return match self.current_values { signed16(values) => values; else => storage_mismatch<int16>() } }
    func uint16_values() uint16[] { return match self.current_values { unsigned16(values) => values; else => storage_mismatch<uint16>() } }
    func int32_values() int32[] { return match self.current_values { signed32(values) => values; else => storage_mismatch<int32>() } }
    func uint32_values() uint32[] { return match self.current_values { unsigned32(values) => values; else => storage_mismatch<uint32>() } }
    func int64_values() int64[] { return match self.current_values { signed64(values) => values; else => storage_mismatch<int64>() } }
    func uint64_values() uint64[] { return match self.current_values { unsigned64(values) => values; else => storage_mismatch<uint64>() } }

    func materialized(layout:Layout) CPUStorage {
        return match self.current_values {
            floats(values) => CPUStorage(gather_values<float>(values, layout))
            signed8(values) => CPUStorage(gather_values<int8>(values, layout))
            unsigned8(values) => CPUStorage(gather_values<uint8>(values, layout))
            signed16(values) => CPUStorage(gather_values<int16>(values, layout))
            unsigned16(values) => CPUStorage(gather_values<uint16>(values, layout))
            signed32(values) => CPUStorage(gather_values<int32>(values, layout))
            unsigned32(values) => CPUStorage(gather_values<uint32>(values, layout))
            signed64(values) => CPUStorage(gather_values<int64>(values, layout))
            unsigned64(values) => CPUStorage(gather_values<uint64>(values, layout))
        }
    }

    func gpu(device:GPU.Device) GPUStorage {
        return match self.current_values {
            floats(values) => GPUStorage.upload(device, values)
            signed8(values) => GPUStorage.upload(device, values)
            unsigned8(values) => GPUStorage.upload(device, values)
            signed16(values) => GPUStorage.upload(device, values)
            unsigned16(values) => GPUStorage.upload(device, values)
            signed32(values) => GPUStorage.upload(device, values)
            unsigned32(values) => GPUStorage.upload(device, values)
            signed64(values) => GPUStorage.upload(device, values)
            unsigned64(values) => GPUStorage.upload(device, values)
        }
    }

    static func empty(dtype:DType) CPUStorage {
        if dtype == DType.float32() { var values:float[] = []; return CPUStorage(values) }
        if dtype == DType.int8() { var values:int8[] = []; return CPUStorage(values) }
        if dtype == DType.uint8() { var values:uint8[] = []; return CPUStorage(values) }
        if dtype == DType.int16() { var values:int16[] = []; return CPUStorage(values) }
        if dtype == DType.uint16() { var values:uint16[] = []; return CPUStorage(values) }
        if dtype == DType.int32() { var values:int32[] = []; return CPUStorage(values) }
        if dtype == DType.uint32() { var values:uint32[] = []; return CPUStorage(values) }
        if dtype == DType.int64() { var values:int64[] = []; return CPUStorage(values) }
        var values:uint64[] = []
        return CPUStorage(values)
    }
}

enum Storage {
    cpu(CPUStorage)
    gpu(GPUStorage)
}

nocopy class GPUKernelCache {
    private static var compilation_count:int = 0
    private var current_device:GPU.Device
    private var elementwise_pipeline:GPU.ComputePipeline? = null
    private var binary_pipeline:GPU.ComputePipeline? = null
    private var reduction_pipeline:GPU.ComputePipeline? = null
    private var linear_pipeline:GPU.ComputePipeline? = null
    private var gather_pipeline:GPU.ComputePipeline? = null
    private var convolution_pipeline:GPU.ComputePipeline? = null
    private var pooling_pipeline:GPU.ComputePipeline? = null
    private var dropout_pipeline:GPU.ComputePipeline? = null

    init(device:GPU.Device) { self.current_device = device }

    func elementwise() GPU.ComputePipeline {
        if var pipeline = self.elementwise_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Elementwise.hlsl"),
            "Tensor float32 elementwise"
        )
        self.elementwise_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func binary() GPU.ComputePipeline {
        if var pipeline = self.binary_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Binary.hlsl"),
            "Tensor float32 binary"
        )
        self.binary_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func reduction() GPU.ComputePipeline {
        if var pipeline = self.reduction_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Reduction.hlsl"),
            "Tensor float32 reduction"
        )
        self.reduction_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func linear() GPU.ComputePipeline {
        if var pipeline = self.linear_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Linear.hlsl"),
            "Tensor float32 linear algebra"
        )
        self.linear_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func gather() GPU.ComputePipeline {
        if var pipeline = self.gather_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Gather.hlsl"),
            "Tensor float32 gather"
        )
        self.gather_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func convolution() GPU.ComputePipeline {
        if var pipeline = self.convolution_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Convolution.hlsl"),
            "Tensor float32 convolution"
        )
        self.convolution_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func pooling() GPU.ComputePipeline {
        if var pipeline = self.pooling_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Pooling.hlsl"),
            "Tensor float32 pooling"
        )
        self.pooling_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    func dropout() GPU.ComputePipeline {
        if var pipeline = self.dropout_pipeline { return pipeline }
        var pipeline = self.current_device.compute_pipeline(
            GPU.ComputeProgram.hlsl(file:"Shaders/Dropout.hlsl"),
            "Tensor float32 dropout"
        )
        self.dropout_pipeline = pipeline
        GPUKernelCache.compilation_count++
        return pipeline
    }

    module static func compilations() int { return GPUKernelCache.compilation_count }
    module static func reset_compilations() { GPUKernelCache.compilation_count = 0 }
}

package func gpu_pipeline_compilations() int { return GPUKernelCache.compilations() }
package func reset_gpu_pipeline_compilations() { GPUKernelCache.reset_compilations() }

package struct GPUPerformanceStatistics {
    let buffer_allocations:int
    let upload_staging_allocations:int
    let download_staging_allocations:int
    let fence_creations:int
}

class GPUPerformanceCounters {
    private static var buffer_allocations:int = 0
    private static var upload_staging_allocations:int = 0
    private static var download_staging_allocations:int = 0
    private static var fence_creations:int = 0

    module static func record_buffer() { GPUPerformanceCounters.buffer_allocations++ }
    module static func record_upload_staging() { GPUPerformanceCounters.upload_staging_allocations++ }
    module static func record_download_staging() { GPUPerformanceCounters.download_staging_allocations++ }
    module static func record_fence() { GPUPerformanceCounters.fence_creations++ }

    module static func reset() {
        GPUPerformanceCounters.buffer_allocations = 0
        GPUPerformanceCounters.upload_staging_allocations = 0
        GPUPerformanceCounters.download_staging_allocations = 0
        GPUPerformanceCounters.fence_creations = 0
    }

    module static func statistics() GPUPerformanceStatistics {
        return GPUPerformanceStatistics(
            buffer_allocations:GPUPerformanceCounters.buffer_allocations,
            upload_staging_allocations:GPUPerformanceCounters.upload_staging_allocations,
            download_staging_allocations:GPUPerformanceCounters.download_staging_allocations,
            fence_creations:GPUPerformanceCounters.fence_creations
        )
    }
}

package func gpu_performance_statistics() GPUPerformanceStatistics {
    return GPUPerformanceCounters.statistics()
}

package func reset_gpu_performance_statistics() {
    GPUPerformanceCounters.reset()
}

nocopy class GPUStorage {
    private var current_device:GPU.Device
    private var kernel_cache:GPUKernelCache
    private var current_buffer:GPU.Buffer? = null
    private var upload_buffer:GPU.TransferBuffer? = null
    private var completion:GPU.Fence? = null
    private var parent:GPUStorage? = null
    private var other_parent:GPUStorage? = null
    private let current_dtype:DType
    private let element_count:int

    init(
        device:GPU.Device,
        cache:GPUKernelCache,
        buffer:GPU.Buffer?,
        upload:GPU.TransferBuffer?,
        completion:GPU.Fence?,
        parent:GPUStorage?,
        other:GPUStorage?,
        dtype:DType,
        count:int
    ) {
        self.current_device = device
        self.kernel_cache = cache
        self.current_buffer = buffer
        self.upload_buffer = upload
        self.completion = completion
        self.parent = parent
        self.other_parent = other
        self.current_dtype = dtype
        self.element_count = count
    }

    drop {
        if var fence = self.completion { fence.wait() }
        self.completion = null
        self.upload_buffer = null
        self.current_buffer = null
        self.parent = null
        self.other_parent = null
    }

    func dtype() DType { return self.current_dtype }
    func count() int { return self.element_count }
    func same_device(other:@GPU.Device) bool { return self.current_device == other }
    func same_device(other:@GPUStorage) bool { return self.current_device == other.current_device }

    static func upload(device:GPU.Device, values:float[]) GPUStorage {
        let dtype = DType.float32()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 4)), "Tensor float32 upload")
        upload.write_floats(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:int8[]) GPUStorage {
        let dtype = DType.int8()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(values.count()), "Tensor int8 upload")
        upload.write_int8s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:uint8[]) GPUStorage {
        let dtype = DType.uint8()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(values.count()), "Tensor uint8 upload")
        upload.write_uint8s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:int16[]) GPUStorage {
        let dtype = DType.int16()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 2)), "Tensor int16 upload")
        upload.write_int16s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:uint16[]) GPUStorage {
        let dtype = DType.uint16()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 2)), "Tensor uint16 upload")
        upload.write_uint16s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:int32[]) GPUStorage {
        let dtype = DType.int32()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 4)), "Tensor int32 upload")
        upload.write_int32s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:uint32[]) GPUStorage {
        let dtype = DType.uint32()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 4)), "Tensor uint32 upload")
        upload.write_uint32s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:int64[]) GPUStorage {
        let dtype = DType.int64()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 8)), "Tensor int64 upload")
        upload.write_int64s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }
    static func upload(device:GPU.Device, values:uint64[]) GPUStorage {
        let dtype = DType.uint64()
        if values.is_empty() { return GPUStorage.empty(device, dtype) }
        var upload = device.upload_buffer(gpu_byte_count(checked_byte_count(values.count(), 8)), "Tensor uint64 upload")
        upload.write_uint64s(@values[0:values.count()])
        return GPUStorage.finish_upload(device, upload, dtype, values.count())
    }

    func cpu_storage() CPUStorage {
        if self.element_count == 0 { return CPUStorage.empty(self.current_dtype) }
        let byte_count = checked_byte_count(self.element_count, self.current_dtype.byte_width())
        var download = self.current_device.download_buffer(gpu_byte_count(byte_count), "Tensor download")
        GPUPerformanceCounters.record_download_staging()
        var commands = self.current_device.commands()
        var transfer = commands.copy()
        transfer.download(self.required_buffer(), download, byte_count)
        transfer.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        completed.wait()
        if self.current_dtype == DType.float32() { return CPUStorage(download.read_floats(count:self.element_count)) }
        if self.current_dtype == DType.int8() { return CPUStorage(download.read_int8s(count:self.element_count)) }
        if self.current_dtype == DType.uint8() { return CPUStorage(download.read_uint8s(count:self.element_count)) }
        if self.current_dtype == DType.int16() { return CPUStorage(download.read_int16s(count:self.element_count)) }
        if self.current_dtype == DType.uint16() { return CPUStorage(download.read_uint16s(count:self.element_count)) }
        if self.current_dtype == DType.int32() { return CPUStorage(download.read_int32s(count:self.element_count)) }
        if self.current_dtype == DType.uint32() { return CPUStorage(download.read_uint32s(count:self.element_count)) }
        if self.current_dtype == DType.int64() { return CPUStorage(download.read_int64s(count:self.element_count)) }
        return CPUStorage(download.read_uint64s(count:self.element_count))
    }

    func contiguous(layout:Layout) GPUStorage {
        if layout.count() == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        let width = self.current_dtype.byte_width()
        let byte_count = checked_byte_count(layout.count(), width)
        var output = GPUStorage.allocate_buffer(
            self.current_device, gpu_byte_count(byte_count), "Tensor contiguous storage"
        )
        var commands = self.current_device.commands()
        var transfer = commands.copy()
        var logical = 0
        while logical < layout.count() {
            transfer.copy(
                self.required_buffer(),
                output,
                width,
                layout:checked_byte_count(layout.flat_storage_index(logical), width),
                offset:checked_byte_count(logical, width),
                cycle:false
            )
            logical++
        }
        transfer.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, layout.count())
    }

    func scalar(layout:Layout, operation:BinaryOperation, value:float) GPUStorage {
        let count = layout.count()
        var metadata = elementwise_metadata(binary_code(operation), layout)
        if count == 0 { return self }
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 result"
        )
        var pipeline = self.kernel_cache.elementwise()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        commands.compute_uniform(1, value)
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, count)
    }

    func unary(layout:Layout, operation:UnaryOperation) GPUStorage {
        let count = layout.count()
        var metadata = elementwise_metadata(unary_code(operation), layout)
        if count == 0 { return self }
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 unary result"
        )
        var pipeline = self.kernel_cache.elementwise()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        commands.compute_uniform(1, 0.0)
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, count)
    }

    func binary(
        other:GPUStorage,
        left_layout:Layout,
        right_layout:Layout,
        output_shape:int[],
        operation:BinaryOperation
    ) GPUStorage {
        let count = shape_product(output_shape)
        var metadata = binary_metadata(binary_code(operation), output_shape, left_layout, right_layout)
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 binary result"
        )
        var pipeline = self.kernel_cache.binary()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.storage_buffer(1, other.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, other, self.current_dtype, count)
    }

    func reduction(
        layout:Layout,
        axes:int[],
        keep_dimensions:bool,
        operation:ReductionOperation,
        output_shape:int[]
    ) GPUStorage {
        let count = shape_product(output_shape)
        var metadata = reduction_metadata(operation, layout, axes, keep_dimensions, count)
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 reduction result"
        )
        var pipeline = self.kernel_cache.reduction()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, count)
    }

    func linear(
        other:GPUStorage,
        left_layout:Layout,
        right_layout:Layout,
        operation:LinearOperation,
        output_shape:int[]
    ) GPUStorage {
        let count = shape_product(output_shape)
        var metadata = linear_metadata(left_layout, right_layout, operation, count)
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 linear result"
        )
        var pipeline = self.kernel_cache.linear()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.storage_buffer(1, other.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, other, self.current_dtype, count)
    }

    func concatenate(
        other:GPUStorage,
        left_layout:Layout,
        right_layout:Layout,
        axis:int
    ) GPUStorage {
        let count = left_layout.count() + right_layout.count()
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        let width = self.current_dtype.byte_width()
        let inner = trailing_product(left_layout.shape(), axis + 1)
        let left_block = checked_product(left_layout.shape()[axis], inner, "Tensor concatenate block size overflows int")
        let right_block = checked_product(right_layout.shape()[axis], inner, "Tensor concatenate block size overflows int")
        let block = left_block + right_block
        var output = GPUStorage.allocate_buffer(
            self.current_device,
            gpu_byte_count(checked_byte_count(count, width)),
            "Tensor concatenated storage"
        )
        var commands = self.current_device.commands()
        var transfer = commands.copy()
        var logical = 0
        while logical < count {
            let within = logical % block
            let outer = logical / block
            if within < left_block {
                transfer.copy(
                    self.required_buffer(), output, width,
                    layout:checked_byte_count(left_layout.flat_storage_index(outer * left_block + within), width),
                    offset:checked_byte_count(logical, width), cycle:false
                )
            } else {
                transfer.copy(
                    other.required_buffer(), output, width,
                    layout:checked_byte_count(right_layout.flat_storage_index(outer * right_block + within - left_block), width),
                    offset:checked_byte_count(logical, width), cycle:false
                )
            }
            logical++
        }
        transfer.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, other, self.current_dtype, count)
    }

    func gather(indices:GPUStorage, source:Layout, index_layout:Layout, axis:int) GPUStorage {
        let count = index_layout.count()
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var metadata = gather_metadata(source, index_layout, axis)
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 gather result"
        )
        var pipeline = self.kernel_cache.gather()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.storage_buffer(1, indices.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, indices, self.current_dtype, count)
    }

    func convolution(
        kernel:GPUStorage,
        input_layout:Layout,
        kernel_layout:Layout,
        output_shape:int[],
        stride:int,
        padding:int
    ) GPUStorage {
        let count = shape_product(output_shape)
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var metadata = convolution_metadata(input_layout, kernel_layout, output_shape, stride, padding)
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 convolution result"
        )
        var pipeline = self.kernel_cache.convolution()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.storage_buffer(1, kernel.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, kernel, self.current_dtype, count)
    }

    func pooling(
        input_layout:Layout,
        output_shape:int[],
        kernel_size:int,
        stride:int,
        padding:int,
        operation:PoolOperation
    ) GPUStorage {
        let count = shape_product(output_shape)
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var metadata = pooling_metadata(input_layout, output_shape, kernel_size, stride, padding, operation)
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 pooling result"
        )
        var pipeline = self.kernel_cache.pooling()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, count)
    }

    func dropout(layout:Layout, probability:float, seed:int, iteration:int) GPUStorage {
        let count = layout.count()
        if count == 0 { return GPUStorage.empty(self.current_device, self.kernel_cache, self.current_dtype) }
        var metadata = elementwise_metadata(0, layout)
        var output = GPUStorage.allocate_buffer(
            self.current_device, checked_byte_count(count, 4), "Tensor float32 dropout result"
        )
        var pipeline = self.kernel_cache.dropout()
        var commands = self.current_device.commands()
        commands.compute_uniform(0, @metadata[0:metadata.count()])
        commands.compute_uniform(1, probability)
        commands.compute_uniform(2, 1.0 / (1.0 - probability))
        var counter_words:uint32[] = [seed as uint32, iteration as uint32]
        var counter_bytes = uint32_bytes(counter_words)
        commands.compute_uniform(3, @counter_bytes[0:counter_bytes.count()])
        var writable:GPU.WritableBuffer[] = [GPU.WritableBuffer(buffer:output)]
        var compute = commands.compute(buffers:writable)
        compute.bind(pipeline)
        compute.storage_buffer(0, self.required_buffer())
        compute.dispatch(count)
        compute.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(self.current_device, self.kernel_cache, output, null, completed, self, null, self.current_dtype, count)
    }

    private static func empty(device:GPU.Device, dtype:DType) GPUStorage {
        var cache = GPUKernelCache(device)
        return GPUStorage.empty(device, cache, dtype)
    }

    private static func empty(device:GPU.Device, cache:GPUKernelCache, dtype:DType) GPUStorage {
        var buffer = GPUStorage.allocate_buffer(device, 4, "Tensor empty storage")
        return GPUStorage(device, cache, buffer, null, null, null, null, dtype, 0)
    }

    private static func finish_upload(device:GPU.Device, upload:GPU.TransferBuffer, dtype:DType, count:int) GPUStorage {
        let byte_count = checked_byte_count(count, dtype.byte_width())
        GPUPerformanceCounters.record_upload_staging()
        var buffer = GPUStorage.allocate_buffer(device, gpu_byte_count(byte_count), "Tensor storage")
        var commands = device.commands()
        var transfer = commands.copy()
        transfer.upload(upload, buffer, byte_count)
        transfer.finish()
        var completed = commands.submit_and_track()
        GPUPerformanceCounters.record_fence()
        return GPUStorage(device, GPUKernelCache(device), buffer, upload, completed, null, null, dtype, count)
    }

    private static func allocate_buffer(device:GPU.Device, size:int, name:str) GPU.Buffer {
        GPUPerformanceCounters.record_buffer()
        return device.buffer(GPU.BufferSettings(
            size:size,
            usage:GPU.BufferUsage.storage(),
            name:name
        ))
    }

    private func required_buffer() GPU.Buffer {
        if var buffer = self.current_buffer { return buffer }
        panic("Tensor empty GPU storage has no buffer")
    }
}

func elementwise_metadata(operation:int, layout:Layout) uint8[] {
    require_gpu_layout(layout)
    var words:uint32[] = []
    words.append(operation as uint32)
    words.append(layout.count() as uint32)
    words.append(layout.rank() as uint32)
    words.append(layout.offset() as uint32)
    append_padded_shape(words, layout.shape())
    append_padded_strides(words, layout.strides(), layout.shape(), layout.rank())
    while words.count() < 16 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func binary_metadata(
    operation:int,
    output_shape:int[],
    left:Layout,
    right:Layout
) uint8[] {
    if output_shape.count() > 5 { panic("Tensor GPU broadcasting supports ranks up to 5") }
    require_gpu_layout(left)
    require_gpu_layout(right)
    let count = shape_product(output_shape)
    require_gpu_uint32(count, "element count")
    var words:uint32[] = []
    words.append(operation as uint32)
    words.append(count as uint32)
    words.append(output_shape.count() as uint32)
    words.append(left.offset() as uint32)
    words.append(right.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    append_padded_shape(words, output_shape)
    while words.count() < 16 { words.append(0 as uint32) }
    append_padded_broadcast_strides(words, left, output_shape.count())
    while words.count() < 24 { words.append(0 as uint32) }
    append_padded_broadcast_strides(words, right, output_shape.count())
    while words.count() < 32 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func reduction_metadata(
    operation:ReductionOperation,
    layout:Layout,
    axes:int[],
    keep_dimensions:bool,
    output_count:int
) uint8[] {
    require_gpu_layout(layout)
    require_gpu_uint32(output_count, "reduction output count")
    let domain_count = reduction_domain_size(layout.shape(), axes)
    require_gpu_uint32(domain_count, "reduction domain count")
    let reduced = reduction_mask(layout.rank(), axes)
    var words:uint32[] = []
    words.append(reduction_code(operation) as uint32)
    words.append(layout.count() as uint32)
    words.append(layout.rank() as uint32)
    words.append(output_count as uint32)
    words.append(domain_count as uint32)
    words.append(layout.offset() as uint32)
    if keep_dimensions { words.append(1 as uint32) }
    else { words.append(0 as uint32) }
    words.append(0 as uint32)
    append_padded_shape(words, layout.shape())
    while words.count() < 16 { words.append(1 as uint32) }
    append_padded_strides(words, layout.strides(), layout.shape(), layout.rank())
    while words.count() < 24 { words.append(0 as uint32) }
    var axis = 0
    while axis < layout.rank() {
        if reduced[axis] { words.append(1 as uint32) }
        else { words.append(0 as uint32) }
        axis++
    }
    while words.count() < 32 { words.append(0 as uint32) }
    return uint32_bytes(words)
}

func linear_metadata(
    left:Layout,
    right:Layout,
    operation:LinearOperation,
    output_count:int
) uint8[] {
    require_gpu_layout(left)
    require_gpu_layout(right)
    require_gpu_uint32(output_count, "linear output count")
    let (rows, columns, shared) = linear_dimensions(left, right, operation)
    require_gpu_uint32(rows, "linear row count")
    require_gpu_uint32(columns, "linear column count")
    require_gpu_uint32(shared, "linear inner dimension")
    var batch_rank = 0
    if operation == LinearOperation.matrix_multiply { batch_rank = output_count_rank(left, right) }
    var words:uint32[] = []
    words.append(rows as uint32)
    words.append(columns as uint32)
    words.append(shared as uint32)
    words.append(output_count as uint32)
    words.append(batch_rank as uint32)
    words.append(left.rank() as uint32)
    words.append(right.rank() as uint32)
    if operation == LinearOperation.dot { words.append(1 as uint32) }
    else { words.append(0 as uint32) }
    words.append(left.offset() as uint32)
    words.append(right.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    var output_batch:int[] = []
    var axis = 0
    while axis < batch_rank {
        let left_axis = axis - (batch_rank - (left.rank() - 2))
        let right_axis = axis - (batch_rank - (right.rank() - 2))
        var dimension = 1
        if left_axis >= 0 { dimension = left.shape()[left_axis] }
        if right_axis >= 0 && right.shape()[right_axis] > dimension { dimension = right.shape()[right_axis] }
        output_batch.append(dimension)
        axis++
    }
    append_padded_shape(words, output_batch)
    append_padded_shape(words, left.shape())
    append_padded_strides(words, left.strides(), left.shape(), left.rank())
    append_padded_shape(words, right.shape())
    append_padded_strides(words, right.strides(), right.shape(), right.rank())
    return uint32_bytes(words)
}

func output_count_rank(left:Layout, right:Layout) int {
    var rank = left.rank() - 2
    if right.rank() - 2 > rank { rank = right.rank() - 2 }
    return rank
}

func gather_metadata(source:Layout, indices:Layout, axis:int) uint8[] {
    require_gpu_layout(source)
    require_gpu_layout(indices)
    var words:uint32[] = []
    words.append(indices.count() as uint32)
    words.append(source.rank() as uint32)
    words.append(axis as uint32)
    words.append(source.offset() as uint32)
    words.append(indices.rank() as uint32)
    words.append(indices.offset() as uint32)
    words.append(source.shape()[axis] as uint32)
    words.append(0 as uint32)
    append_padded_shape(words, source.shape())
    append_padded_strides(words, source.strides(), source.shape(), source.rank())
    append_padded_shape(words, indices.shape())
    append_padded_strides(words, indices.strides(), indices.shape(), indices.rank())
    return uint32_bytes(words)
}

func convolution_metadata(
    input:Layout, kernel:Layout, output_shape:int[], stride:int, padding:int
) uint8[] {
    require_gpu_layout(input)
    require_gpu_layout(kernel)
    var words:uint32[] = []
    words.append(shape_product(output_shape) as uint32)
    words.append(stride as uint32)
    words.append(padding as uint32)
    words.append(input.offset() as uint32)
    words.append(kernel.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    for value in input.shape() { words.append(value as uint32) }
    for value in input.strides() { words.append(value as uint32) }
    for value in kernel.shape() { words.append(value as uint32) }
    for value in kernel.strides() { words.append(value as uint32) }
    for value in output_shape { words.append(value as uint32) }
    return uint32_bytes(words)
}

func pooling_metadata(
    input:Layout, output_shape:int[], kernel_size:int, stride:int,
    padding:int, operation:PoolOperation
) uint8[] {
    require_gpu_layout(input)
    var words:uint32[] = []
    words.append(shape_product(output_shape) as uint32)
    words.append(kernel_size as uint32)
    words.append(stride as uint32)
    words.append(padding as uint32)
    if operation == PoolOperation.maximum { words.append(0 as uint32) }
    else { words.append(1 as uint32) }
    words.append(input.offset() as uint32)
    words.append(0 as uint32)
    words.append(0 as uint32)
    for value in input.shape() { words.append(value as uint32) }
    for value in input.strides() { words.append(value as uint32) }
    for value in output_shape { words.append(value as uint32) }
    return uint32_bytes(words)
}

func reduction_code(operation:ReductionOperation) int {
    return match operation { sum => 0; mean => 1; minimum => 2; maximum => 3 }
}

func require_gpu_layout(layout:Layout) {
    if layout.rank() > 5 { panic("Tensor GPU computation supports ranks up to 5") }
    require_gpu_uint32(layout.count(), "element count")
    require_gpu_uint32(layout.offset(), "layout offset")
    for dimension in layout.shape() { require_gpu_uint32(dimension, "shape dimension") }
    for stride in layout.strides() { require_gpu_uint32(stride, "layout stride") }
}

func require_gpu_uint32(value:int, subject:str) {
    if value < 0 || value > 4294967295 { panic("Tensor GPU $(subject) exceeds uint32") }
}

func append_padded_shape(words:&uint32[], shape:int[]) {
    for value in shape { words.append(value as uint32) }
    var axis = shape.count()
    while axis < 8 { words.append(1 as uint32); axis++ }
}

func append_padded_strides(words:&uint32[], strides:int[], shape:int[], rank:int) {
    var axis = 0
    while axis < rank {
        if shape[axis] == 1 { words.append(0 as uint32) }
        else { words.append(strides[axis] as uint32) }
        axis++
    }
    while axis < 8 { words.append(0 as uint32); axis++ }
}

func append_padded_broadcast_strides(words:&uint32[], layout:Layout, output_rank:int) {
    let shape = layout.shape()
    let strides = layout.strides()
    let missing = output_rank - layout.rank()
    var axis = 0
    while axis < output_rank {
        let input_axis = axis - missing
        if input_axis < 0 || shape[input_axis] == 1 { words.append(0 as uint32) }
        else { words.append(strides[input_axis] as uint32) }
        axis++
    }
}

func uint32_bytes(words:uint32[]) uint8[] {
    var bytes:uint8[] = []
    for word in words {
        bytes.append((word & 255) as uint8)
        bytes.append(((word >> 8) & 255) as uint8)
        bytes.append(((word >> 16) & 255) as uint8)
        bytes.append(((word >> 24) & 255) as uint8)
    }
    return bytes
}

func gather_values<T>(values:T[], layout:Layout) T[] {
    var result:T[] = []
    var logical = 0
    while logical < layout.count() {
        result.append(values[layout.flat_storage_index(logical)])
        logical++
    }
    return result
}

func storage_mismatch<T>() T[] { panic("Tensor internal storage dtype mismatch") }

func gpu_byte_count(logical_count:int) int {
    if logical_count < 4 { return 4 }
    return logical_count
}
