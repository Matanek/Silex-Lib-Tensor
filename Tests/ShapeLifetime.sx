use Tensor
use Tensor.Autograd
use Tensor.Profile
use Tensor.autograd_performance_statistics
use GFX.GPU

func shape_cycle(device:GPU.Device) {
    var input = Autograd.Variable(Tensor.ones([2,3]).to(device))
    let output = input.value().transpose().unsqueeze(0).expand([2,3,2]).repeat([2,1,3]).sum()
    var gradients = Autograd.grad(output,[input.value()])
    assert(gradients[0].is_gpu() && input.gradient() == null)
}

test "shape views and tiled graphs release nodes and GPU buffers" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    let baseline = autograd_performance_statistics()
    var profile = Profile(device)
    var iteration = 0
    while iteration < 32 {
        shape_cycle(device)
        let state = autograd_performance_statistics()
        assert(state.live_nodes == baseline.live_nodes && state.retained_edges == baseline.retained_edges)
        assert(profile.snapshot().live_buffers == 0 && profile.snapshot().active_bytes == 0)
        iteration++
    }
}
