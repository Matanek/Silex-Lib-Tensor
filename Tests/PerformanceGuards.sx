use GFX.GPU
use Tensor
use Tensor.Profile
use Tensor.gpu_performance_statistics
use Tensor.gpu_pipeline_compilations
use Tensor.reset_gpu_performance_statistics
use Tensor.reset_gpu_pipeline_compilations

func five_operation_chain(left:Tensor, right:Tensor) Tensor {
    return left.add(1.0).multiply(0.5).matmul(right).sum().add(1.0)
}

test "bound resident allocations fences staging and pipeline creation" {
    if !GPU.Device.is_supported() { return }
    reset_gpu_performance_statistics()
    reset_gpu_pipeline_compilations()
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var profile = Profile(device)
    let left = Tensor.ones([2, 2]).to(device)
    let right = Tensor.ones([2, 2]).to(device)
    device.wait_until_idle()

    var result = five_operation_chain(left, right)
    device.wait_until_idle()
    let cold = gpu_performance_statistics()
    assert(cold.buffer_allocations + profile.snapshot().buffer_reuses == 7)
    assert(cold.buffer_releases >= 0 && cold.buffer_releases <= 3)
    assert(cold.live_buffers == cold.buffer_allocations - cold.buffer_releases)
    assert(cold.peak_live_buffers <= 7)
    assert(cold.upload_staging_allocations == 2)
    assert(cold.download_staging_allocations == 0)
    assert(cold.fence_creations == 7)
    assert(gpu_pipeline_compilations() == 3)

    assert(result.cpu().item() == 9.0)
    let after_readback = gpu_performance_statistics()
    let observed = profile.snapshot()
    assert(after_readback.buffer_releases == 0)
    assert(observed.in_use_buffers == 3 && observed.active_bytes == 36)
    assert(after_readback.live_buffers == observed.in_use_buffers + observed.cached_buffers)
    assert(after_readback.download_staging_allocations == 1)
    assert(after_readback.fence_creations == 8)

    device.reset_command_stats()
    var iteration = 0
    while iteration < 8 {
        result = five_operation_chain(left, right)
        device.wait_until_idle()
        iteration++
    }
    let warm = gpu_performance_statistics()
    let commands = device.command_stats()
    let resources = profile.snapshot()
    assert(warm.buffer_allocations + resources.buffer_reuses == 47)
    assert(resources.buffer_reuses > 0 && warm.buffer_allocations < 47)
    assert(warm.buffer_releases == warm.buffer_allocations - warm.live_buffers)
    // Fence readiness can retire ancestors early but is not a resource bound.
    // Two persistent inputs plus five results remain in use without early retirement.
    // Assignment may overlap the old and new five-result chains: 2 + 5 + 5.
    assert(resources.in_use_buffers <= 7 && resources.peak_in_use_buffers <= 12)
    assert(resources.cached_buffers <= 32 && resources.cached_bytes <= 1048576)
    assert(warm.live_buffers == resources.in_use_buffers + resources.cached_buffers)
    assert(warm.peak_live_buffers <= 12 + 32)
    assert(resources.allocated_bytes == resources.active_bytes + resources.cached_bytes)
    assert(warm.upload_staging_allocations == 2)
    assert(warm.download_staging_allocations == 1)
    assert(warm.fence_creations == 48)
    assert(gpu_pipeline_compilations() == 3)
    assert(commands.uploads == 0 && commands.downloads == 0)
    assert(commands.compute_passes == 40)
}
