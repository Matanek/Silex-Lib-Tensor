use Tensor
use Tensor.TopKResult
use Tensor.DType
use Tensor.Autograd
use Tensor.Profile
use GFX.GPU
use STD.Math

func top_indices(actual:Tensor, expected:int32[]) {
    assert(actual.dtype() == DType.int32())
    let values = actual.int32_values()
    assert(values.count() == expected.count())
    var i = 0
    while i < values.count() { assert(values[i] == expected[i]); i++ }
}

func qualify_topk(device:GPU.Device) {
    let nan = Math.sqrt(-1.0)
    var data:float[] = [9.0,1.0,9.0,-2.0,nan,nan]
    let source = Tensor(data,[2,1,3,1,1]).to(device).permute([2,1,0,3,4]).narrow(0,1,2)
    var profile = Profile(device)
    let selected = source.topk(2,axis:2)
    let reverse = source.topk(2,axis:2,largest:false)
    assert(selected.values.is_gpu() && selected.indices.is_gpu())
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0 && profile.snapshot().pipeline_compilations == 2)
    var upper:int32[] = [1,0,1,0]
    top_indices(selected.indices.cpu(),upper); top_indices(reverse.indices.cpu(),upper)
    let actual = selected.values.cpu().values()
    assert(Math.is_nan(actual[0]) && actual[1] == 1.0 && Math.is_nan(actual[2]) && actual[3] == 9.0)
    profile.reset()
    let repeated = source.narrow(2,0,1).expand([2,1,4,1,1]).topk(3,axis:2)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0 && profile.snapshot().pipeline_compilations == 0)
    var first:int32[] = [0,1,2,0,1,2]
    top_indices(repeated.indices.cpu(),first)
}

func values_after_source_scope(device:GPU.Device) TopKResult {
    var values:float[] = [2.0,7.0,7.0]
    return Tensor.vector(values).to(device).topk(2,axis:0)
}
func main() {
    assert(GPU.Device.is_supported())
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    qualify_topk(device)
    var data:float[] = [1.0,4.0,2.0,3.0,6.0,5.0]; var seed:float[] = [2.0,5.0,7.0,11.0]
    var input = Autograd.Variable(Tensor(data,[2,3]).to(device))
    let gradient = Tensor(seed,[2,2]).to(device)
    var profile = Profile(device)
    var gradients = Autograd.grad(input.value().topk(2,axis:1).values,[input.value()],seed:gradient)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    let values = gradients[0].cpu().values()
    assert(values[0] == 0.0 && values[1] == 2.0 && values[2] == 5.0 && values[3] == 0.0 && values[4] == 7.0 && values[5] == 11.0 && input.gradient() == null)
    profile.reset()
    let retained = values_after_source_scope(device)
    assert(profile.snapshot().uploads == 1 && profile.snapshot().downloads == 0)
    var first:int32[] = [1,2]
    top_indices(retained.indices.cpu(),first)
    let kept = retained.values.cpu().values()
    assert(kept[0] == 7.0 && kept[1] == 7.0)
    print("Tensor top-k qualification passed")
}
