use Tensor
use Tensor.DType
use Tensor.Profile
use GFX.GPU
use STD.Math

func indices_equal(actual:Tensor, expected:int32[]) {
    assert(actual.dtype() == DType.int32())
    let values = actual.int32_values()
    assert(values.count() == expected.count())
    var i = 0
    while i < values.count() { assert(values[i] == expected[i]); i++ }
}

func gpu_indices(device:GPU.Device) {
    let nan = Math.sqrt(-1.0)
    var values:float[] = [9.0,1.0,9.0,-2.0,nan,nan]
    let source = Tensor(values,[2,1,3,1,1]).to(device).permute([2,1,0,3,4])
    var profile = Profile(device)
    let global = source.argmax(); let rows = source.argmin(axis:0,keep_dimensions:true); let maximum = source.argmax(axis:2)
    assert(global.is_gpu() && global.dtype() == DType.int32())
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    assert(profile.snapshot().pipeline_compilations == 1)
    var expected_global:int32[] = [3]; var expected_rows:int32[] = [1,1]; var expected_columns:int32[] = [0,1,1]
    indices_equal(global.cpu(),expected_global); indices_equal(rows.cpu(),expected_rows); indices_equal(maximum.cpu(),expected_columns)
    profile.reset()
    let offset = source.narrow(0,1,2).argmax()
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    var expected_offset:int32[] = [1]
    indices_equal(offset.cpu(),expected_offset)
    profile.reset()
    let repeated = source.narrow(2,0,1).expand([3,1,4,1,1]).argmin(axis:2)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0 && profile.snapshot().pipeline_compilations == 0)
    var first:int32[] = [0,0,0]
    indices_equal(repeated.cpu(),first)
}

func indices_after_source_scope(device:GPU.Device) Tensor {
    var values:float[] = [2.0,7.0,7.0]
    return Tensor.vector(values).to(device).argmax()
}

func main() {
    assert(GPU.Device.is_supported())
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    gpu_indices(device)
    var profile = Profile(device)
    let retained = indices_after_source_scope(device)
    assert(profile.snapshot().uploads == 1 && profile.snapshot().downloads == 0)
    var first:int32[] = [1]
    indices_equal(retained.cpu(),first)
    print("Tensor indexed reductions qualification passed")
}
