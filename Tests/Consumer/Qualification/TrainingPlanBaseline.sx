use TrainingPlanBaseline as Baseline
use GFX.GPU
use Tensor.Profile
func main() {
    assert(GPU.Device.is_supported())
    var device=GPU.Device(GPU.DeviceSettings(debug:true))
    var profile=Profile(device)
    Baseline.qualify(device,false)
    Baseline.qualify(device,true)
    let counts=profile.snapshot()
    assert(counts.live_buffers==0 && counts.in_use_buffers==0 && counts.cached_buffers==0 && counts.allocated_bytes==0)
    print("TRAINING_BASELINE_RESOURCES status=pass live=0 peak_buffers=$(counts.peak_in_use_buffers) peak_bytes=$(counts.peak_allocated_bytes)")
}
