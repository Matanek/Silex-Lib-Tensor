use Tensor
use Tensor.Autograd
use Tensor.Profile
use GFX.GPU

func verify(device:GPU.Device) {
    var values:float[] = [1.0,2.0,3.0]
    var input = Autograd.Variable(Tensor.vector(values).to(device))
    var profile = Profile(device)
    let view = input.value().unsqueeze(0).expand([2,3])
    assert(profile.snapshot().buffer_allocations == 0 && profile.snapshot().submissions == 0)
    let tiled = view.repeat([2,1])
    assert(tiled.shape()[0] == 4 && tiled.is_contiguous())
    var gradients = Autograd.grad(tiled.multiply(tiled).sum(),[input.value()])
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    let actual = gradients[0].cpu().values()
    assert(actual[0] == 8.0 && actual[1] == 16.0 && actual[2] == 24.0)
    assert(input.gradient() == null)
    let zero = Tensor.ones([1,3]).to(device).expand([0,3]).repeat([2,4])
    assert(zero.shape()[0] == 0 && zero.shape()[1] == 12 && zero.count() == 0)
}
func main() {
    assert(GPU.Device.is_supported())
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    verify(device)
    print("Tensor shape qualification passed")
}
