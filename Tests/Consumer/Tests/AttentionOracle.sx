// Generated by Tools/Oracle/attention_decimal.py; independent Decimal attention and VJP.
use Tensor
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU
use STD.Math

func attention_oracle_near(actual:Tensor, expected:float[]) {
    let values=actual.detach().cpu().values()
    assert(values.count()==expected.count())
    var i=0
    while i<values.count() {assert(Math.is_finite(values[i]) && Math.abs(values[i]-expected[i])<0.000002);i++}
}
func decimal_attention(device:GPU.Device?, default_scale:bool) {
    var qs:float[]=[0.125,-0.5,0.75,0.25]
    var ks:float[]=[0.5,1.25,-0.75,0.125,0.25,-0.5]
    var vs:float[]=[1.5,-0.25,0.5,0.75,-1.25,2.0]
    var seeds:float[]=[0.2,-0.3,0.7,-1.1]
    var flags:bool[]=[false,false,false,true,false,true]
    var q=Tensor(qs,[1,2,2]);var k=Tensor(ks,[1,3,2]);var v=Tensor(vs,[1,3,2]);var mask=Tensor(flags,[1,2,3]);var seed=Tensor(seeds,[1,2,2])
    if let gpu=device {q=q.to(gpu);k=k.to(gpu);v=v.to(gpu);mask=mask.to(gpu);seed=seed.to(gpu)}
    var query=Autograd.Variable(q);var key=Autograd.Variable(k);var value=Autograd.Variable(v)
    var scale:float?=0.5
    if default_scale {scale=null}
    let result=Neural.attention(query.value(),key.value(),value.value(),mask:mask,scale:scale,return_weights:true)
    var gradients=Autograd.grad(result.output,[query.value(),key.value(),value.value()],seed:seed)
    if !default_scale {
        attention_oracle_near(result.output,[0.0,0.0,0.3381122542609823,0.7006354283319236])
        if let weights=result.weights {attention_oracle_near(weights,[0.0,0.0,0.0,0.5774953651858118,0.0,0.42250463481418826])}
        else {panic("expected oracle attention weights")}
        attention_oracle_near(gradients[0],[0.0,0.0,0.13419695760609474,0.939378703242663])
        attention_oracle_near(gradients[1],[0.40259087281828415,0.13419695760609474,0.0,0.0,-0.40259087281828415,-0.13419695760609474])
        attention_oracle_near(gradients[2],[0.40424675563006823,-0.635244901704393,0.0,0.0,0.2957532443699318,-0.46475509829560707])
    }
    else {
        attention_oracle_near(result.output,[0.0,0.0,0.4239844294681156,0.6303763758897236])
        if let weights=result.weights {attention_oracle_near(weights,[0.0,0.0,0.0,0.6087216107156784,0.0,0.3912783892843216])}
        else {panic("expected oracle attention weights")}
        attention_oracle_near(gradients[0],[0.0,0.0,0.18526026016897132,1.2968218211827993])
        attention_oracle_near(gradients[1],[0.5557807805069139,0.18526026016897132,0.0,0.0,-0.5557807805069139,-0.18526026016897132])
        attention_oracle_near(gradients[2],[0.4261051275009749,-0.6695937717872462,0.0,0.0,0.2738948724990251,-0.43040622821275376])
    }
}
test "attention explicit and default scale outputs and QKV gradients match Decimal on CPU" {decimal_attention(null,false);decimal_attention(null,true)}
test "attention explicit and default scale outputs and QKV gradients match Decimal on Metal" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true));decimal_attention(device,false);decimal_attention(device,true)
}
