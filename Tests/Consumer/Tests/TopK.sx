use Tensor
use Tensor.DType
use Tensor.Autograd
use Tensor.Profile
use GFX.GPU
use STD.Math

func top_indices(actual:Tensor, expected:int32[]) {
    assert(actual.dtype() == DType.int32())
    let values = actual.int32_values()
    assert(values.count() == expected.count())
    var i = 0
    while i < values.count() { assert(values[i] == expected[i]); i++ }
}

test "top-k returns ordered values and stable indices on explicit axes" {
    var data:float[] = [1.0,4.0,2.0,3.0,6.0,5.0]
    let source = Tensor(data,[2,3])
    let selected = source.topk(2,axis:1)
    var expected:int32[] = [1,2,1,2]
    top_indices(selected.indices,expected)
    let values = selected.values.values()
    assert(values[0] == 4.0 && values[1] == 2.0 && values[2] == 6.0 && values[3] == 5.0)
    assert(selected.values.shape()[0] == 2 && selected.values.shape()[1] == 2)
    assert(source.shape()[0] == 2 && source.shape()[1] == 3)
    var lower:int32[] = [0,2,0,2]
    top_indices(source.topk(2,axis:1,largest:false).indices,lower)
    var column:int32[] = [1,1,1,0,0,0]
    top_indices(source.topk(2,axis:0).indices,column)
}

test "top-k keeps first indices of ties NaNs and signed zeros" {
    var data:float[] = [5.0,5.0,2.0,5.0]
    var expected:int32[] = [0,1,3,2]
    top_indices(Tensor.vector(data).topk(4,axis:0).indices,expected)
    let nan = Math.sqrt(-1.0)
    var nonfinite:float[] = [1.0,nan,1.0/0.0,nan,-1.0/0.0]
    var upper:int32[] = [1,3,2,0,4]; var lower:int32[] = [1,3,4,0,2]
    top_indices(Tensor.vector(nonfinite).topk(5,axis:0).indices,upper)
    top_indices(Tensor.vector(nonfinite).topk(5,axis:0,largest:false).indices,lower)
    var zero:float[] = [0.0,-0.0,0.0]; var first:int32[] = [0,1,2]
    let result = Tensor.vector(zero).topk(3,axis:0,largest:false)
    top_indices(result.indices,first)
    let values = result.values.values()
    assert(1.0/values[0] > 0.0 && 1.0/values[1] < 0.0 && 1.0/values[2] > 0.0)
}

test "top-k handles k zero empty outer domains and strided sources" {
    assert(Tensor.zeros([0]).topk(0,axis:0).values.count() == 0)
    let source = Tensor.ones([2,3])
    assert(source.topk(0,axis:1).indices.shape()[0] == 2 && source.topk(0,axis:1).indices.shape()[1] == 0)
    assert(Tensor.zeros([0,3]).topk(2,axis:1).values.count() == 0)
    var data:float[] = [9.0,1.0,9.0,-2.0,1.0,-2.0]
    let view = Tensor(data,[2,3]).transpose().narrow(0,1,2)
    var expected:int32[] = [0,1,0,1]
    top_indices(view.topk(2,axis:1).indices,expected)
    var repeated:int32[] = [0,0,0,1,1,1]
    top_indices(Tensor(data,[2,3]).narrow(0,1,1).expand([4,3]).topk(2,axis:0).indices,repeated)
}

func integer_topk<T>() {
    var data:T[] = [5 as T,1 as T,5 as T,2 as T]
    let result = Tensor.vector(data).topk(3,axis:0)
    var expected:int32[] = [0,2,3]
    top_indices(result.indices,expected)
    assert(result.values.dtype() == Tensor.vector(data).dtype())
}

test "top-k compares all CPU dtypes without float promotion" {
    integer_topk<int8>(); integer_topk<uint8>(); integer_topk<int16>(); integer_topk<uint16>()
    integer_topk<int32>(); integer_topk<uint32>(); integer_topk<int64>(); integer_topk<uint64>()
    let maximum:uint64 = 0xffff_ffff_ffff_ffff
    var values:uint64[] = [maximum-(1 as uint64),maximum,0]
    var expected:int32[] = [1,0,2]
    let result = Tensor.vector(values).topk(3,axis:0)
    top_indices(result.indices,expected)
    assert(result.values.uint64_values()[0] == maximum && result.values.uint64_values()[1] == maximum-(1 as uint64))
    var signed:int64[] = [9223372036854775806,9223372036854775807,(-9223372036854775807)-1]
    top_indices(Tensor.vector(signed).topk(3,axis:0).indices,expected)
}

func topk_loss(inputs:Tensor[]) Tensor { return inputs[0].topk(2,axis:1).values.sum() }

test "top-k values have analytical gradients and pass gradcheck away from ties" {
    var data:float[] = [1.0,4.0,2.0,3.0,6.0,5.0]
    var input = Autograd.Variable(Tensor(data,[2,3]))
    var seed:float[] = [2.0,5.0,7.0,11.0]
    var gradients = Autograd.grad(input.value().topk(2,axis:1).values,[input.value()],seed:Tensor(seed,[2,2]))
    let values = gradients[0].values()
    assert(values[0] == 0.0 && values[1] == 2.0 && values[2] == 5.0 && values[3] == 0.0 && values[4] == 7.0 && values[5] == 11.0)
    assert(input.gradient() == null)
    assert(Autograd.gradcheck(topk_loss,[Tensor(data,[2,3])],epsilon:0.01,absolute_tolerance:0.003,relative_tolerance:0.003).passed)
}

func qualify_topk(device:GPU.Device) {
    let nan = Math.sqrt(-1.0)
    var data:float[] = [9.0,1.0,9.0,-2.0,nan,nan]
    let source = Tensor(data,[2,1,3,1,1]).to(device).permute([2,1,0,3,4]).narrow(0,1,2)
    var profile = Profile(device)
    let selected = source.topk(2,axis:2)
    let reverse = source.topk(2,axis:2,largest:false)
    assert(selected.values.is_gpu() && selected.indices.is_gpu())
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0 && profile.snapshot().pipeline_compilations == 2)
    var upper:int32[] = [1,0,1,0]
    top_indices(selected.indices.cpu(),upper); top_indices(reverse.indices.cpu(),upper)
    let actual = selected.values.cpu().values()
    assert(Math.is_nan(actual[0]) && actual[1] == 1.0 && Math.is_nan(actual[2]) && actual[3] == 9.0)
    profile.reset()
    let repeated = source.narrow(2,0,1).expand([2,1,4,1,1]).topk(3,axis:2)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0 && profile.snapshot().pipeline_compilations == 0)
    var first:int32[] = [0,1,2,0,1,2]
    top_indices(repeated.indices.cpu(),first)
}

test "GPU top-k remains resident on rank five offset and expanded views" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    qualify_topk(device)
}

test "GPU top-k values differentiate with exact seeded selection gradients" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var data:float[] = [1.0,4.0,2.0,3.0,6.0,5.0]; var seed:float[] = [2.0,5.0,7.0,11.0]
    var input = Autograd.Variable(Tensor(data,[2,3]).to(device))
    let gradient = Tensor(seed,[2,2]).to(device)
    var profile = Profile(device)
    var gradients = Autograd.grad(input.value().topk(2,axis:1).values,[input.value()],seed:gradient)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    let values = gradients[0].cpu().values()
    assert(values[0] == 0.0 && values[1] == 2.0 && values[2] == 5.0 && values[3] == 0.0 && values[4] == 7.0 && values[5] == 11.0 && input.gradient() == null)
}

test "GPU top-k k zero and empty outer outputs retain zero gradients" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var input = Autograd.Variable(Tensor.ones([2,3]).to(device))
    let empty = Tensor.zeros([0,3]).to(device); let no_domain = Tensor.zeros([0]).to(device)
    var profile = Profile(device)
    let selected = input.value().topk(0,axis:1)
    var gradients = Autograd.grad(selected.values.sum(),[input.value()])
    let outer = empty.topk(2,axis:1); let none = no_domain.topk(0,axis:0)
    assert(outer.values.count() == 0 && none.indices.count() == 0 && selected.values.is_gpu())
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    for value in gradients[0].cpu().values() { assert(value == 0.0) }
}

test "top-k agrees with an independent count of outranking values on both axes" {
    var data:float[] = []
    var r = 0
    while r < 5 {
        var c = 0
        while c < 7 { data.append(((r*11+c*3)%13-6) as float); c++ }
        r++
    }
    let source = Tensor(data,[5,7])
    var direction = 0
    while direction < 2 {
        let largest = direction == 0
        var rows:int32[] = []; var columns:int32[] = []
        var i = 0
        while i < 35 { rows.append(0 as int32); columns.append(0 as int32); i++ }
        r = 0
        while r < 5 {
            var c = 0
            while c < 7 {
                var rank = 0; var other = 0
                while other < 7 {
                    let a = data[r*7+other]; let b = data[r*7+c]
                    if (largest && a > b) || (!largest && a < b) || (a == b && other < c) { rank++ }
                    other++
                }
                rows[r*7+rank] = c as int32
                rank = 0; other = 0
                while other < 5 {
                    let a = data[other*7+c]; let b = data[r*7+c]
                    if (largest && a > b) || (!largest && a < b) || (a == b && other < r) { rank++ }
                    other++
                }
                columns[rank*7+c] = r as int32
                c++
            }
            r++
        }
        top_indices(source.topk(7,axis:1,largest:largest).indices,rows)
        top_indices(source.topk(5,axis:0,largest:largest).indices,columns)
        if GPU.Device.is_supported() {
            var device = GPU.Device(GPU.DeviceSettings(debug:true))
            let gpu = source.to(device)
            var profile = Profile(device)
            let selected_rows = gpu.topk(7,axis:1,largest:largest)
            let selected_columns = gpu.topk(5,axis:0,largest:largest)
            assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
            top_indices(selected_rows.indices.cpu(),rows); top_indices(selected_columns.indices.cpu(),columns)
            let actual = selected_columns.values.cpu().values()
            var c = 0
            while c < 7 {
                var j = 0
                while j < 5 { assert(actual[j*7+c] == data[(columns[j*7+c] as int)*7+c]); j++ }
                c++
            }
        }
        direction++
    }
}

test "GPU top-k retains first NaNs and original signed zeros" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    let nan = Math.sqrt(-1.0)
    var data:float[] = [1.0,nan,1.0/0.0,nan,-1.0/0.0]
    var zero:float[] = [0.0,-0.0,0.0]
    let source = Tensor.vector(data).to(device); let zeros = Tensor.vector(zero).to(device)
    var profile = Profile(device)
    let high = source.topk(5,axis:0); let low = source.topk(5,axis:0,largest:false); let signs = zeros.topk(3,axis:0)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    var upper:int32[] = [1,3,2,0,4]; var lower:int32[] = [1,3,4,0,2]; var first:int32[] = [0,1,2]
    top_indices(high.indices.cpu(),upper); top_indices(low.indices.cpu(),lower); top_indices(signs.indices.cpu(),first)
    let values = signs.values.cpu().values()
    assert(1.0/values[0] > 0.0 && 1.0/values[1] < 0.0 && 1.0/values[2] > 0.0)
}

func topk_shared_gradient(value:Tensor) Tensor {
    return value.expand([2,4]).topk(3,axis:1).values.sum()
}

test "top-k accumulates expanded source gradients and preserves stored slots" {
    var data:float[] = [2.0,5.0]
    var input = Autograd.Variable(Tensor(data,[2,1]))
    input.value().multiply(9.0).sum().backward()
    var gradients = Autograd.grad(topk_shared_gradient(input.value()),[input.value()])
    for value in gradients[0].values() { assert(value == 3.0) }
    if let previous = input.gradient() { for value in previous.values() { assert(value == 9.0) } }
    else { panic("top-k changed stored slots") }
    if GPU.Device.is_supported() {
        var device = GPU.Device(GPU.DeviceSettings(debug:true))
        var gpu = Autograd.Variable(Tensor(data,[2,1]).to(device))
        var profile = Profile(device)
        var gpu_gradients = Autograd.grad(topk_shared_gradient(gpu.value()),[gpu.value()])
        assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
        for value in gpu_gradients[0].cpu().values() { assert(value == 3.0) }
        assert(gpu.gradient() == null)
    }
}
