test "Transformer pre and post norm match Decimal output and sixteen parameter VJPs on CPU" {decimal_transformer(null,true);decimal_transformer(null,false)}
test "Transformer pre and post norm match Decimal on Metal" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true));decimal_transformer(device,true);decimal_transformer(device,false)
}
