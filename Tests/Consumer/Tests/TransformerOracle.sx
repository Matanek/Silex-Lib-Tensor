// Generated Decimal Transformer forward/VJP fixture.
use Tensor
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU
use STD.Math

func transformer_oracle_near(actual:Tensor,expected:float[]) {
    let data=actual.detach().cpu().values();assert(data.count()==expected.count())
    var i=0;while i<data.count() {assert(Math.is_finite(data[i]) && Math.abs(data[i]-expected[i])<0.000008);i++}
}
func decimal_transformer(device:GPU.Device?,norm_first:bool) {
    var model=Neural.TransformerBlock("block",4,2,6,seed:19,norm_first:norm_first,epsilon:0.001)
    var parameters=model.parameters();assert(parameters.count()==16)
    assert(parameters[0].name()=="block.attention.query.weight");var p0=parameters[0]
    var data0:float[]=[-0.5,-0.2,0.1,0.4,0.2,0.5,-0.5,-0.2,-0.4,-0.1,0.2,0.5,0.3,0.6,-0.4,-0.1];p0.replace(Tensor(data0,[4, 4]))
