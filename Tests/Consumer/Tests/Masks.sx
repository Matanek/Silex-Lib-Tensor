test "exact uint64 masks and selection" {
    let maximum:uint64 = 0xffff_ffff_ffff_ffff
    var values:uint64[] = [0 as uint64, (maximum) - (1 as uint64), maximum]
    let input = Tensor.vector(values)
    let mask = input.less_than(maximum)
    let flags = mask.bool_values()
    assert(flags[0] && flags[1] && !flags[2])
    let equal = input.equal(input).bool_values()
    assert(equal[0] && equal[1] && equal[2])
    let result = Tensor.where(mask, input, Tensor.scalar(1 as uint64)).uint64_values()
    assert(result[0] == 0 as uint64 && result[1] == values[1] && result[2] == 1 as uint64)
}

test "all six comparisons agree with scalar relations" {
    var values:float[] = [-2.0, 0.0, 2.0]
    let input = Tensor.vector(values)
    let eq = input.equal(0.0).bool_values()
    let ne = input.not_equal(0.0).bool_values()
    let lt = input.less_than(0.0).bool_values()
    let le = input.less_equal(0.0).bool_values()
    let gt = input.greater_than(0.0).bool_values()
    let ge = input.greater_equal(0.0).bool_values()
    var i = 0
    while i < 3 {
        assert(eq[i] == (values[i] == 0.0) && ne[i] == (values[i] != 0.0))
        assert(lt[i] == (values[i] < 0.0) && le[i] == (values[i] <= 0.0))
        assert(gt[i] == (values[i] > 0.0) && ge[i] == (values[i] >= 0.0))
        i++
    }
}

test "GPU broadcast branch gradients and aliases" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var a:float[] = [1.0, 2.0, 3.0]
    var b:float[] = [10.0, 20.0]
    var flags:bool[] = [true, false, true, false, true, false]
    var left = Autograd.Variable(Tensor(a, [1, 3]).to(device))
    var right = Autograd.Variable(Tensor(b, [2, 1]).to(device))
    let mask = Tensor(flags, [2, 3]).to(device)
    Tensor.where(mask, left.value(), right.value()).sum().backward()
    var expected_left:float[] = [1.0, 1.0, 1.0]
    var expected_right:float[] = [1.0, 2.0]
    mask_near(mask_gradient(left).cpu().values(), expected_left)
    mask_near(mask_gradient(right).cpu().values(), expected_right)
    var alias = Autograd.Variable(Tensor.vector(a).to(device))
    Tensor.where(mask.narrow(0, 0, 1).flatten(), alias.value(), alias.value()).sum().backward()
    mask_near(mask_gradient(alias).cpu().values(), expected_left)
}
