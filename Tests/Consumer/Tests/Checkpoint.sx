use STD.File
use STD.FileSystem
use STD.Math
use Tensor
use Tensor.Neural

func checkpoint_values_match(left:float[], right:float[]) bool {
    if left.count() != right.count() { return false }
    var index = 0
    while index < left.count() {
        if Math.abs(left[index] - right[index]) > 0.000001 { return false }
        index++
    }
    return true
}
func checkpoint_model(seed:int) Neural.Sequential {
    var layers:Neural.Layer[] = [
        Neural.Dense("hidden", 2, 3, seed),
        Neural.Activation.tanh(),
        Neural.Dense("output", 3, 2, seed + 1)
    ]
    return Neural.Sequential(layers)
}

test "save deterministic parameters and restore a fresh model" {
    let first_path = "/private/tmp/tensor-part11-checkpoint-a.sxtc"
    let second_path = "/private/tmp/tensor-part11-checkpoint-b.sxtc"
    let ignored_first = FileSystem.remove_file(first_path)
    let ignored_second = FileSystem.remove_file(second_path)
    var source = checkpoint_model(31)
    var restored = checkpoint_model(97)
    var input_values:float[] = [1.0, -2.0, 0.5, 0.25]
    let input = Tensor(input_values, [2, 2])
    let expected = source.forward(input).detach().values()

    Neural.Checkpoint.save(source, first_path)
    Neural.Checkpoint.save(source, second_path)
    match File.read_text(first_path, 1_000_000) {
        success(first) => {
            match File.read_text(second_path, 1_000_000) {
                success(second) => { assert(first == second) }
                failure(error) => { panic(error.detail) }
            }
        }
        failure(error) => { panic(error.detail) }
    }

    Neural.Checkpoint.load(restored, first_path)
    let actual = restored.forward(input).detach().values()
    assert(checkpoint_values_match(actual, expected))
    match FileSystem.remove_file(first_path) {
        success => {}
        failure(error) => { panic(error.detail) }
    }
    match FileSystem.remove_file(second_path) {
        success => {}
        failure(error) => { panic(error.detail) }
    }
}
