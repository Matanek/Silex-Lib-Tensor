use Tensor
use Tensor.DType
use STD.Math

func sequence_equals(actual:Tensor, expected:int32[]) {
    let values = actual.int32_values()
    assert(actual.is_cpu() && actual.dtype() == DType.int32() && actual.rank() == 1 && values.count() == expected.count())
    var i = 0
    while i < expected.count() { assert(values[i] == expected[i]); i++ }
}

test "integer progressions keep exclusive stops and explicit direction" {
    var forward:int32[] = [1,4,7]
    var backward:int32[] = [7,4,1]
    var ordinary:int32[] = [0,1,2,3]
    sequence_equals(Tensor.arange(1,8,3),forward)
    sequence_equals(Tensor.arange(7,0,-3),backward)
    sequence_equals(Tensor.arange(4),ordinary)
    assert(Tensor.arange(2,2).count() == 0 && Tensor.arange(3,1).count() == 0)
    assert(Tensor.arange(1,3,-1).count() == 0 && Tensor.arange(-3).count() == 0)
}

test "integer progressions preserve int32 limits and large int64 strides" {
    var upper:int32[] = [2147483645,2147483646,2147483647]
    var lower:int32[] = [-2147483646,-2147483647,-2147483648]
    sequence_equals(Tensor.arange(2147483645,2147483648),upper)
    sequence_equals(Tensor.arange(-2147483646,-2147483649,-1),lower)
    var one:int32[] = [-1]
    let minimum:int = (-9223372036854775807)-1
    sequence_equals(Tensor.arange(-1,minimum,minimum),one)
    var other:int32[] = [1]
    sequence_equals(Tensor.arange(1,9223372036854775807,9223372036854775807),other)
    assert(Tensor.arange(9223372036854775807,minimum,1).count() == 0)
}

test "float grids preserve endpoints and count zero or one" {
    let values = Tensor.linspace(-1.0,1.0,5).values()
    assert(values[0] == -1.0 && values[1] == -0.5 && values[2] == 0.0 && values[3] == 0.5 && values[4] == 1.0)
    assert(Tensor.linspace(1.0,2.0,0).count() == 0 && Tensor.linspace(1.0,2.0,1).item() == 1.0)
    let descending = Tensor.linspace(3.0,-1.0,3).values()
    assert(descending[0] == 3.0 && descending[1] == 1.0 && descending[2] == -1.0)
    for value in Tensor.linspace(4.0,4.0,7).values() { assert(value == 4.0) }
}

test "float grids stay finite and bounded near opposite extremes" {
    let values = Tensor.linspace(-3.0e38,3.0e38,5).values()
    assert(values[0] == -3.0e38 && values[4] == 3.0e38 && values[2] == 0.0)
    for value in values { assert(Math.is_finite(value) && value >= -3.0e38 && value <= 3.0e38) }
    for value in Tensor.linspace(3.0e38,3.3e38,19).values() { assert(Math.is_finite(value) && value >= 3.0e38 && value <= 3.3e38) }
}

use GFX.GPU
use Tensor.Profile

test "explicit GPU transfer preserves generated values and counts uploads" {
    if !GPU.Device.is_supported() { return }
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var profile = Profile(device)
    let indices = Tensor.arange(-3,4,2)
    let grid = Tensor.linspace(-1.0,1.0,5)
    assert(profile.snapshot().uploads == 0 && profile.snapshot().downloads == 0)
    let gpu_indices = indices.to(device)
    let gpu_grid = grid.to(device)
    assert(profile.snapshot().uploads == 2 && profile.snapshot().downloads == 0)
    let actual = gpu_indices.cpu().int32_values()
    assert(actual[0] == -3 && actual[1] == -1 && actual[2] == 1 && actual[3] == 3)
    let values = gpu_grid.cpu().values()
    assert(values[0] == -1.0 && values[2] == 0.0 && values[4] == 1.0)
    assert(profile.snapshot().downloads == 2)
}

test "float grids preserve signed zero endpoints and monotone rounding bounds" {
    let zero = Tensor.linspace(-0.0,0.0,2).values()
    assert(1.0/zero[0] < 0.0 && 1.0/zero[1] > 0.0)
    var count = 2
    while count < 23 {
        let grid = Tensor.linspace(1.0,9.0,count).values()
        assert(grid[0] == 1.0 && grid[count-1] == 9.0)
        var i = 1
        while i < count { assert(grid[i] >= grid[i-1] && grid[i] <= 9.0); i++ }
        count++
    }
}
