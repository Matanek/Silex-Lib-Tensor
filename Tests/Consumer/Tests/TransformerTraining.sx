use Tensor
use Tensor.Neural
use Tensor.Data
use Tensor.Optim
use Tensor.Profile
use STD.Math
use STD.File
use STD.FileSystem
use GFX.GPU

nocopy class TinyTransformer:Neural.Layer {
    private var tokens:Neural.Embedding
    private var positions:Neural.Buffer
    private var visibility:Neural.Buffer
    private var block:Neural.TransformerBlock
    private var classifier:Neural.Dense

    init(seed:int, norm_first:bool = true, dropout_probability:float = 0.0) {
        self.tokens=Neural.Embedding("language.tokens",4,4,seed,padding_index:0)
        self.block=Neural.TransformerBlock("language.block",4,2,8,seed+1,norm_first:norm_first,dropout_probability:dropout_probability)
        self.classifier=Neural.Dense("language.classifier",4,4,seed+2)
        var positions:float[]=[]
        var index=0
        while index<3 {
            positions.append(Math.sin(index as float));positions.append(Math.cos(index as float))
            positions.append(Math.sin((index as float)*0.01));positions.append(Math.cos((index as float)*0.01))
            index++
        }
        self.positions=Neural.Buffer("language.positions",Tensor(positions,[1,3,4]))
        self.visibility=Neural.Buffer("language.visibility",Neural.causal_mask(3,3))
        self.register_child("tokens",self.tokens)
        self.register_child("block",self.block)
        self.register_child("classifier",self.classifier)
        self.register_buffer(self.positions);self.register_buffer(self.visibility)
    }
    override func forward(input:Tensor) Tensor {return self.predict(input,0)}
    func predict(input:Tensor,iteration:int) Tensor {
        let embeddings=self.tokens.forward(input).add(self.positions.value())
        return self.classifier.forward(self.block.encode(embeddings,mask:self.visibility.value(),iteration:iteration).output)
    }
}
func transformer_source() Data.TensorSource {
    var ids:int32[]=[1,2,3,2,3,1,3,1,2,1,2,3,2,3,1,3,1,2]
    var next:int32[]=[2,3,1,3,1,2,1,2,3,2,3,1,3,1,2,1,2,3]
    return Data.TensorSource(Tensor(ids,[6,3]),Tensor(next,[6,3]))
}
func transformer_training_step(model:TinyTransformer,optimizer:Optim.AdamW,cursor:Data.BatchCursor,step:int,device:GPU.Device?) {
    var active=model;var optim=optimizer;var reading=cursor
    var batch=try reading.next() else error {panic(error)}
    if batch==null {reading.set_epoch(reading.state().epoch+1);batch=try reading.next() else error {panic(error)}}
    if var value=batch {
        if let gpu=device {value.input=value.input.to(gpu);value.target=value.target.to(gpu)}
        active.predict(value.input,step).cross_entropy(value.target,2).backward();optim.step();optim.zero_grad()
    } else {panic("empty Transformer training source")}
}
func transformer_checkpoint_text(path:str) str {
    match (try File.read_text(path,1024*1024)) {success(text)=>{return text};failure(error)=>{panic(error.detail)}}
}
func transformer_checkpoint_remove(path:str) {
    try FileSystem.remove_file(path) else error {panic(error.detail)}
}
func transformer_resume(device:GPU.Device?) {
    let first="/private/tmp/tensor-transformer-a.sxtc";let second="/private/tmp/tensor-transformer-b.sxtc"
    var left=TinyTransformer(17,dropout_probability:0.2)
    var cursor=Data.BatchCursor(transformer_source(),2,shuffle:true,seed:7)
    if let gpu=device {left.to(gpu)}
    var optimizer=Optim.AdamW(left.parameters(),learning_rate:0.03,weight_decay:0.01)
    var step=0
    while step<3 {transformer_training_step(left,optimizer,cursor,step,device);step++}
    try Neural.TrainingCheckpoint.save(left,optimizer,cursor,Neural.TrainingProgress(step:step),first) else error {panic(error)}
    var right=TinyTransformer(97,dropout_probability:0.2);right.eval()
    var resumed_cursor=Data.BatchCursor(transformer_source(),2,shuffle:true,seed:7,prefetch:2)
    var resumed=Optim.AdamW(right.parameters(),learning_rate:1.0)
    let progress=try Neural.TrainingCheckpoint.load(right,resumed,resumed_cursor,first) else error {panic(error)}
    assert(progress.step==3 && right.is_training() && cursor.state()==resumed_cursor.state())
    assert(right.parameters().count()==19 && right.buffers().count()==2)
    try Neural.TrainingCheckpoint.save(right,resumed,resumed_cursor,progress,second) else error {panic(error)}
    assert(transformer_checkpoint_text(first)==transformer_checkpoint_text(second))
    var incompatible=TinyTransformer(99,norm_first:false,dropout_probability:0.2)
    var rejected=Optim.AdamW(incompatible.parameters(),learning_rate:1.0)
    let before=incompatible.parameters()[0].value().detach().values()
    match (try Neural.TrainingCheckpoint.load(incompatible,rejected,resumed_cursor,first)) {
        success(ignored)=>{panic("accepted incompatible Transformer norm convention")}
        failure(error)=>{assert(error!="")}
    }
    let after=incompatible.parameters()[0].value().detach().values()
    var i=0;while i<before.count() {assert(before[i]==after[i]);i++}
    if let gpu=device {let moments=resumed.state().to(gpu);right.to(gpu);try resumed.restore(moments) else error {panic(error)}}
    while step<8 {
        transformer_training_step(left,optimizer,cursor,step,device)
        transformer_training_step(right,resumed,resumed_cursor,step,device);step++
        try Neural.TrainingCheckpoint.save(left,optimizer,cursor,Neural.TrainingProgress(step:step),first) else error {panic(error)}
        try Neural.TrainingCheckpoint.save(right,resumed,resumed_cursor,Neural.TrainingProgress(step:step),second) else error {panic(error)}
        assert(transformer_checkpoint_text(first)==transformer_checkpoint_text(second))
        let embedding=right.parameters()[0].value().detach().cpu().values()
        assert(embedding[0]==0.0 && embedding[1]==0.0 && embedding[2]==0.0 && embedding[3]==0.0)
    }
    transformer_checkpoint_remove(first);transformer_checkpoint_remove(second)
}
test "external causal Transformer restores positions modes dropout batches and AdamW exactly on CPU" {transformer_resume(null)}
test "external causal Transformer resumes on Metal with explicit weight and moment transfers" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true));transformer_resume(device)
}
func transformer_learns(device:GPU.Device?) {
    var model=TinyTransformer(17)
    var cursor=Data.BatchCursor(transformer_source(),6,shuffle:false)
    if var batch=try cursor.next() else error {panic(error)} {
        if let gpu=device {model.to(gpu);batch.input=batch.input.to(gpu);batch.target=batch.target.to(gpu)}
        model.eval()
        let initial=model.forward(batch.input).cross_entropy(batch.target,2).detach().cpu().values()[0]
        var optimizer=Optim.AdamW(model.parameters(),learning_rate:0.04)
        model.train()
        var step=0
        while step<30 {
            var profile:Profile?=null;if let gpu=device {profile=Profile(gpu)}
            model.predict(batch.input,step).cross_entropy(batch.target,2).backward();optimizer.step();optimizer.zero_grad()
            if let p=profile {assert(p.snapshot().uploads==0 && p.snapshot().downloads==0)}
            step++
        }
        model.eval()
        let final=model.forward(batch.input).cross_entropy(batch.target,2).detach().cpu().values()[0]
        print("Tiny Transformer loss: ",initial," -> ",final)
        assert(Math.is_finite(final) && final<initial*0.4)
    } else {panic("empty Transformer learning source")}
}
test "a public causal Transformer learns local next-token targets on CPU and Metal without hidden transfers" {
    transformer_learns(null)
    if GPU.Device.is_supported() {var device=GPU.Device(GPU.DeviceSettings(debug:true));transformer_learns(device)}
}
