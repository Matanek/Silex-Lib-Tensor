// Qualification publique de l’étape fermée MSE/AdamW.
use Tensor
use Tensor.Neural
use Tensor.Optim
use Tensor.Autograd
use Tensor.Profile
use GFX.GPU
use STD.Math
use STD.Time.Stopwatch


func baseline_model(normalized:bool) Neural.Sequential {
    var layers:Neural.Layer[]=[Neural.Dense("hidden",2,4,101)]
    if normalized {layers.append(Neural.LayerNorm("norm",[4],epsilon:0.25))}
    layers.append(Neural.Activation.tanh())
    layers.append(Neural.Dense("output",4,2,102))
    return Neural.Sequential(layers)
}

func near(left:Tensor,right:Tensor,tolerance:float) {
    let a=left.detach().cpu().values()
    let b=right.detach().cpu().values()
    assert(a.count()==b.count() && left.dtype()==right.dtype())
    assert(left.shape().count()==right.shape().count())
    var i=0
    while i<left.shape().count() {assert(left.shape()[i]==right.shape()[i]);i++}
    i=0
    while i<a.count() {
        if !Math.is_finite(a[i]) || !Math.is_finite(b[i]) || Math.abs(a[i]-b[i])>tolerance {
            print("ADAM_UPDATE_PROBE_MISMATCH index=$(i) left=$(a[i]) right=$(b[i]) tolerance=$(tolerance)")
        }
        assert(Math.is_finite(a[i]) && Math.is_finite(b[i]) && Math.abs(a[i]-b[i])<=tolerance)
        i++
    }
}
func optional_near(left:Tensor?,right:Tensor?,tolerance:float) {
    if let a=left {
        if let b=right {near(a,b,tolerance)} else {panic("missing training state")}
    } else {assert(right==null)}
}
func state_near(left:Optim.AdamWState,right:Optim.AdamWState,tolerance:float) {
    assert(left.learning_rate==right.learning_rate && left.beta1==right.beta1 && left.beta2==right.beta2)
    assert(left.epsilon==right.epsilon && left.weight_decay==right.weight_decay)
    assert(left.parameters.count()==right.parameters.count())
    var i=0
    while i<left.parameters.count() {
        let a=left.parameters[i]
        let b=right.parameters[i]
        assert(a.name==b.name && a.step_count==b.step_count && a.shape.count()==b.shape.count())
        var axis=0
        while axis<a.shape.count() {assert(a.shape[axis]==b.shape[axis]);axis++}
        optional_near(a.first_moment,b.first_moment,tolerance)
        optional_near(a.second_moment,b.second_moment,tolerance)
        i++
    }
}
func model_near(left:Neural.Layer,right:Neural.Layer,tolerance:float) {
    var a=left.parameters()
    var b=right.parameters()
    assert(a.count()==b.count() && left.is_training()==right.is_training())
    assert(left.buffers().count()==right.buffers().count())
    var i=0
    while i<a.count() {
        assert(a[i].name()==b[i].name() && a[i].is_trainable()==b[i].is_trainable())
        near(a[i].value(),b[i].value(),tolerance)
        optional_near(a[i].gradient(),b[i].gradient(),tolerance)
        i++
    }
}
func prepare(model:Neural.Layer,input:Tensor) {
    match model.prepare_forward(input) {failure(reason)=>{panic(reason)};success=>{}}
}

struct Observation {var output:Tensor;var loss:Tensor}

func region(profile:Profile,arm:str,part:str,iteration:int) {
    let count=profile.snapshot()
    assert(count.uploads==0 && count.downloads==0)
    if iteration==0 || iteration==9 {
        print("ADAM_UPDATE_PROBE_REGION arm=$(arm) step=$(iteration) part=$(part) passes=$(count.compute_passes) submissions=$(count.submissions) fences=$(count.fence_creations) pipelines=$(count.pipeline_compilations) allocations=$(count.buffer_allocations) reuses=$(count.buffer_reuses)")
    }
    profile.reset()
}
func step(model:Neural.Layer,optimizer:Optim.AdamW,input:Tensor,target:Tensor,
    profile:Profile?,device:GPU.Device,arm:str,iteration:int,prepared:bool=false) Observation {
    optimizer.zero_grad()
    if var active=profile {active.reset()}
    let output=model.forward(input)
    if var active=profile {device.wait_until_idle();region(active,arm,"forward",iteration)}
    let loss=output.mse_loss(target)
    loss.backward()
    if var active=profile {device.wait_until_idle();region(active,arm,"loss-backward",iteration)}
    optimizer.step()
    if var active=profile {device.wait_until_idle();region(active,arm,"update",iteration)}
    return Observation(output:output.detach(),loss:loss.detach())
}

func planned_step(plan:Neural.TrainingStep,input:Tensor,target:Tensor,profile:Profile,device:GPU.Device,normalized:bool,iteration:int) Observation {
    profile.reset()
    var result=try plan.run(input,target) else error {panic(error)}
    device.wait_until_idle()
    let count=profile.snapshot()
    assert(count.uploads==0 && count.downloads==0 && count.pipeline_compilations==0)
    if iteration==0 || iteration==9 {
        var expected=19
        if normalized {expected=44}
        assert(count.submissions==expected && count.fence_creations==expected)
        print("TRAINING_PLAN_PROBE_REGION step=$(iteration) normalized=$(normalized) passes=$(count.compute_passes) submissions=$(count.submissions) fences=$(count.fence_creations) allocations=$(count.buffer_allocations) reuses=$(count.buffer_reuses)")
    }
    return Observation(output:result.output,loss:result.loss)
}

public func qualify(device:GPU.Device,normalized:bool) {
    var cpu=baseline_model(normalized)
    var eager=baseline_model(normalized)
    var planned=baseline_model(normalized)
    var resumed=baseline_model(normalized)
    eager.to(device);planned.to(device);resumed.to(device)
    var cp=cpu.parameters();var ep=eager.parameters();var pp=planned.parameters();var rp=resumed.parameters()
    var co=Optim.AdamW(cp,learning_rate:0.01,beta1:0.8,beta2:0.9,epsilon:0.01,weight_decay:0.07)
    var eo=Optim.AdamW(ep,learning_rate:0.01,beta1:0.8,beta2:0.9,epsilon:0.01,weight_decay:0.07)
    var po=Optim.AdamW(pp,learning_rate:0.01,beta1:0.8,beta2:0.9,epsilon:0.01,weight_decay:0.07)
    var ro=Optim.AdamW(rp)
    var inputs:float[]=[0.125,-0.25,0.5,-0.75,-0.375,0.25,0.75,0.125]
    var targets:float[]=[0.25,-0.125,-0.5,0.375,0.625,-0.25,0.125,0.75]
    let ci=Tensor(inputs,[4,2]);let ct=Tensor(targets,[4,2])
    let gi=ci.to(device);let gt=ct.to(device)
    var plan=try Neural.TrainingStep.mse(planned,po,gi,gt) else error {panic(error)}
    var resumed_plan:Neural.TrainingStep?=null
    var profile=Profile(device)
    var saved_loss:Tensor?=null
    var saved_values:Tensor?=null
    var iteration=0
    while iteration<12 {
        co.zero_grad();eo.zero_grad();po.zero_grad();ro.zero_grad()
        if iteration==3 {cp[1].freeze();ep[1].freeze();pp[1].freeze()}
        if iteration==6 {cp[1].unfreeze();ep[1].unfreeze();pp[1].unfreeze()}
        if iteration==5 {
            cp[0].replace(cp[0].value().detach().multiply(0.75))
            ep[0].replace(ep[0].value().detach().multiply(0.75))
            pp[0].replace(pp[0].value().detach().multiply(0.75))
        }
        if iteration==6 {
            var i=0
            while i<pp.count() {rp[i].replace(pp[i].value().detach());i++}
            try ro.restore(po.state()) else error {panic(error)}
            resumed_plan=try Neural.TrainingStep.mse(resumed,ro,gi,gt) else error {panic(error)}
            model_near(planned,resumed,0.0)
            state_near(po.state(),ro.state(),0.0)
        }
        var rate:float=0.01
        if iteration>=4 {rate=0.006}
        co.set_learning_rate(rate);eo.set_learning_rate(rate);po.set_learning_rate(rate)
        if iteration>=6 {ro.set_learning_rate(rate)}
        let c=step(cpu,co,ci,ct,null,device,"cpu",iteration)
        let e=step(eager,eo,gi,gt,profile,device,"eager",iteration)
        let p=planned_step(plan,gi,gt,profile,device,normalized,iteration)
        near(p.output,e.output,0.0);near(p.loss,e.loss,0.0)
        near(p.output,c.output,0.00002);near(p.loss,c.loss,0.00002)
        model_near(planned,eager,0.0);state_near(po.state(),eo.state(),0.0)
        model_near(planned,cpu,0.00002);state_near(po.state(),co.state(),0.00002)
        if iteration>=6 {
            var r:Observation=p
            if var current=resumed_plan {r=planned_step(current,gi,gt,profile,device,normalized,iteration)} else {panic("missing resumed plan")}
            near(p.output,r.output,0.0);near(p.loss,r.loss,0.0)
            model_near(planned,resumed,0.0);state_near(po.state(),ro.state(),0.0)
        }
        if iteration==2 {saved_loss=p.loss;saved_values=p.loss.cpu()}
        if iteration==7 {
            var before=po.state()
            var values:Tensor[]=[];var gradients:Tensor?[]=[]
            for var parameter in pp {values.append(parameter.value().detach());gradients.append(parameter.gradient())}
            // Existing hot gradients and moments must survive a rejected preparation.
            match Neural.TrainingStep.mse(planned,po,ci,gt) {failure(reason)=>{assert(reason!="")};success(value)=>{panic("CPU example unexpectedly prepared")}}
            state_near(before,po.state(),0.0)
            var i=0
            while i<pp.count() {near(values[i],pp[i].value(),0.0);optional_near(gradients[i],pp[i].gradient(),0.0);i++}
            match plan.run(ci,gt) {failure(reason)=>{assert(reason!="")};success(value)=>{panic("CPU input unexpectedly ran")}}
            match plan.run(gi,ct) {failure(reason)=>{assert(reason!="")};success(value)=>{panic("CPU target unexpectedly ran")}}
            state_near(before,po.state(),0.0)
            i=0
            while i<pp.count() {near(values[i],pp[i].value(),0.0);optional_near(gradients[i],pp[i].gradient(),0.0);i++}
        }
        assert(plan.statistics().executions==iteration+1)
        iteration++
    }
    optional_near(saved_loss,saved_values,0.0)
    assert(plan.statistics().executions==12)
    if var current=resumed_plan {assert(current.statistics().executions==6)} else {panic("missing resumed plan")}
    let preserved=gi.cpu().values()
    let original=ci.values()
    var i=0
    while i<original.count() {assert(preserved[i]==original[i]);i++}
    near(gt,ct,0.0)
    print("TRAINING_PLAN_PROBE_STATE status=pass normalized=$(normalized) steps=12 restore_boundary=6 eager_gpu=exact cpu_tolerance=0.00002 capture=closed")
}

// Unknown application hooks must be rejected before any model observation.
nocopy class OpenTrainingLayer:Neural.Layer {
    private var calls:int=0
    init() {}
    override func forward(input:Tensor) Tensor {self.calls++;return input}
    override func children() Neural.Layer[] {self.calls++;return []}
    override func parameters() Neural.Parameter[] {self.calls++;return []}
    func count() int {return self.calls}
    func reset() {self.calls=0}
}
func rejected_capture(model:Neural.Layer,optimizer:Optim.AdamW,input:Tensor,target:Tensor) {
    match Neural.TrainingStep.mse(model,optimizer,input,target) {
        failure(reason)=>{assert(reason!="")}
        success(value)=>{panic("expected training capture rejection")}
    }
}
func rejected_run(plan:Neural.TrainingStep,input:Tensor,target:Tensor) {
    match plan.run(input,target) {failure(reason)=>{assert(reason!="")};success(value)=>{panic("expected training signature rejection")}}
}
func short_capture(model:Neural.Layer,optimizer:Optim.AdamW,device:GPU.Device) Neural.TrainingStep {
    return try Neural.TrainingStep.mse(model,optimizer,Tensor.ones([4,2]).to(device),Tensor.zeros([4,2]).to(device)) else error {panic(error)}
}
public func guards(device:GPU.Device,other:GPU.Device) {
    var model=baseline_model(false);model.to(device)
    var optimizer=Optim.AdamW(model.parameters(),epsilon:0.01)
    let input=Tensor.ones([4,2]).to(device);let target=Tensor.zeros([4,2]).to(device)
    var profile=Profile(device)
    profile.reset()
    var plan=try Neural.TrainingStep.mse(model,optimizer,input,target) else error {panic(error)}
    let capture=profile.snapshot()
    assert(capture.compute_passes==0 && capture.submissions==0 && capture.uploads==0 && capture.downloads==0)
    var unknown=OpenTrainingLayer()
    rejected_capture(unknown,optimizer,input,target)
    assert(unknown.count()==0)
    var children:Neural.Layer[]=[Neural.Dense("known",2,2,1),unknown]
    var nested=Neural.Sequential(children)
    unknown.reset()
    rejected_capture(nested,optimizer,input,target)
    assert(unknown.count()==0)
    var unrelated=baseline_model(false);unrelated.to(device)
    var wrong=Optim.AdamW(unrelated.parameters())
    rejected_capture(model,wrong,input,target)
    rejected_capture(model,optimizer,input,Tensor.zeros([3,2]).to(device))
    rejected_capture(model,optimizer,Tensor.zeros([0,2]).to(device),target)
    rejected_capture(model,optimizer,Tensor.ones([1,1,1,1,1,2]).to(device),target)
    var flags:bool[]=[true,false,true,false,true,false,true,false]
    rejected_capture(model,optimizer,Tensor(flags,[4,2]).to(device),target)
    // Populate hot gradients and moments before every rejected execution.
    var initial=try plan.run(input,target) else error {panic(error)}
    var before=optimizer.state()
    var parameters=model.parameters()
    var weights:Tensor[]=[];var gradients:Tensor?[]=[]
    for var parameter in parameters {weights.append(parameter.value().detach());gradients.append(parameter.gradient())}
    let foreign=Tensor.ones([4,2]).to(other)
    let bad_shape=Tensor.ones([3,2]).to(device)
    let bad_view=input.transpose().contiguous().transpose()
    profile.reset()
    rejected_run(plan,foreign,target);rejected_run(plan,input,foreign)
    rejected_run(plan,bad_shape,target);rejected_run(plan,input,bad_shape)
    rejected_run(plan,bad_view,target);rejected_run(plan,input,bad_view)
    model.eval();rejected_run(plan,input,target);model.train()
    let rejected=profile.snapshot()
    assert(rejected.compute_passes==0 && rejected.submissions==0 && rejected.uploads==0 && rejected.downloads==0)
    state_near(before,optimizer.state(),0.0)
    var index=0
    while index<parameters.count() {near(weights[index],parameters[index].value(),0.0);optional_near(gradients[index],parameters[index].gradient(),0.0);index++}
    assert(plan.statistics().executions==1)
    // Capturing a second plan neither clears the old one nor retains examples.
    device.wait_until_idle()
    let retained=profile.snapshot().in_use_buffers
    var second=short_capture(model,optimizer,device)
    assert(profile.snapshot().in_use_buffers==retained)
    var again=try plan.run(input,target) else error {panic(error)}
    var another=try second.run(input,target) else error {panic(error)}
    assert(plan.statistics().executions==2 && second.statistics().executions==1)
    var shared=Neural.Dense("shared",2,2,17);shared.to(device)
    var repeated:Neural.Layer[]=[]
    for i in 0...129 {repeated.append(shared)}
    var excessive=Neural.Sequential(repeated)
    var excessive_optimizer=Optim.AdamW(excessive.parameters())
    profile.reset();rejected_capture(excessive,excessive_optimizer,input,target)
    assert(profile.snapshot().compute_passes==0 && profile.snapshot().submissions==0)
    optimizer.zero_grad();model.freeze()
    var frozen=optimizer.state()
    device.wait_until_idle();profile.reset()
    rejected_run(plan,input,target)
    assert(profile.snapshot().compute_passes==0 && profile.snapshot().submissions==0)
    state_near(frozen,optimizer.state(),0.0)
    for parameter in model.parameters() {assert(parameter.gradient()==null)}
    model.unfreeze()
    var final=try plan.run(input,target) else error {panic(error)}
    assert(plan.statistics().cached_plans==1 && plan.statistics().cache_capacity_plans==1)
    print("TRAINING_PLAN_GUARDS status=pass hooks=0 rejection=before_zero_grad device_mode_layout_shape_dtype=checked examples=not_retained owners=independent operations=bounded")
}
public func replay(device:GPU.Device,normalized:bool) {
    var eager=baseline_model(normalized);var model=baseline_model(normalized)
    eager.to(device);model.to(device)
    var eo=Optim.AdamW(eager.parameters(),learning_rate:0.001,epsilon:0.01,weight_decay:0.0)
    var po=Optim.AdamW(model.parameters(),learning_rate:0.001,epsilon:0.01,weight_decay:0.0)
    var data:float[]=[0.125,-0.25,0.5,-0.75,-0.375,0.25,0.75,0.125]
    let input=Tensor(data,[4,2]).to(device).transpose().contiguous().transpose()
    let target=Tensor.zeros([4,2]).to(device).transpose().contiguous().transpose()
    var plan=try Neural.TrainingStep.mse(model,po,input,target) else error {panic(error)}
    var saved:Observation[]=[];var expected:Observation[]=[]
    var profile=Profile(device)
    var i=0
    while i<1024 {
        eo.zero_grad();po.zero_grad()
        if i==512 {
            var ep=eager.parameters();var pp=model.parameters()
            ep[0].replace(ep[0].value().detach().transpose().contiguous().transpose())
            pp[0].replace(pp[0].value().detach().transpose().contiguous().transpose())
        }
        let e=step(eager,eo,input,target,null,device,"eager",i)
        var p=try plan.run(input,target) else error {panic(error)}
        if i%256==0 {
            near(p.output,e.output,0.0);near(p.loss,e.loss,0.0)
            model_near(model,eager,0.0);state_near(po.state(),eo.state(),0.0)
            saved.append(Observation(output:p.output,loss:p.loss))
            expected.append(Observation(output:p.output.cpu(),loss:p.loss.cpu()))
        }
        i++
    }
    device.wait_until_idle()
    model_near(model,eager,0.0);state_near(po.state(),eo.state(),0.0)
    assert(plan.statistics().executions==1024)
    i=0
    while i<saved.count() {near(saved[i].output,expected[i].output,0.0);near(saved[i].loss,expected[i].loss,0.0);i++}
    let resources=profile.snapshot()
    assert(resources.peak_in_use_buffers<512 && resources.peak_allocated_bytes<262144)
    print("TRAINING_PLAN_REPLAY status=pass steps=1024 normalized=$(normalized) eager_gpu=exact retained=4 strided_input_target_parameter=true peak_buffers=$(resources.peak_in_use_buffers) peak_bytes=$(resources.peak_allocated_bytes)")
}


test "prepared training preserves complete CPU GPU state and warm restoration" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true))
    qualify(device,false);qualify(device,true)
}
test "prepared training rejects before mutation and owns independent bounded recipes" {
    if !GPU.Device.is_supported() {return}
    var first=GPU.Device(GPU.DeviceSettings(debug:true));var second=GPU.Device(GPU.DeviceSettings(debug:true))
    guards(first,second)
}
test "prepared training replays thousands of strided steps without losing retained values" {
    if !GPU.Device.is_supported() {return}
    var first=GPU.Device(GPU.DeviceSettings(debug:true));var second=GPU.Device(GPU.DeviceSettings(debug:true))
    replay(first,false);replay(second,true)
}

func classified_equal(left:Tensor,right:Tensor) {
    let a=left.detach().cpu().values();let b=right.detach().cpu().values()
    assert(a.count()==b.count())
    var i=0
    while i<a.count() {
        if Math.is_nan(a[i]) {assert(Math.is_nan(b[i]))}
        else {assert(a[i]==b[i])}
        i++
    }
}
public func nonfinite(device:GPU.Device) {
    let nan=Tensor.scalar(0.0).divide(0.0).item()
    let infinity=Tensor.scalar(1.0).divide(0.0).item()
    var cases:float[]=[nan,infinity,-infinity]
    for value in cases {
        var eager=Neural.Dense("value",2,2,1);var model=Neural.Dense("value",2,2,1)
        eager.to(device);model.to(device)
        var ep=eager.parameters();var pp=model.parameters()
        ep[0].replace(Tensor.full([2,2],value).to(device));pp[0].replace(Tensor.full([2,2],value).to(device))
        var eo=Optim.AdamW(ep,epsilon:0.01);var po=Optim.AdamW(pp,epsilon:0.01)
        let input=Tensor.ones([2,2]).to(device);let target=Tensor.zeros([2,2]).to(device)
        var plan=try Neural.TrainingStep.mse(model,po,input,target) else error {panic(error)}
        for iteration in 0...2 {
            let e=step(eager,eo,input,target,null,device,"eager",iteration)
            var p=try plan.run(input,target) else error {panic(error)}
            classified_equal(p.output,e.output);classified_equal(p.loss,e.loss)
            var es=eo.state();var ps=po.state();var i=0
            while i<pp.count() {
                classified_equal(pp[i].value(),ep[i].value())
                if let a=pp[i].gradient() {if let b=ep[i].gradient() {classified_equal(a,b)} else {panic("missing eager gradient")}}
                assert(ps.parameters[i].step_count==es.parameters[i].step_count)
                if let a=ps.parameters[i].first_moment {if let b=es.parameters[i].first_moment {classified_equal(a,b)} else {panic("missing eager first")}}
                if let a=ps.parameters[i].second_moment {if let b=es.parameters[i].second_moment {classified_equal(a,b)} else {panic("missing eager second")}}
                i++
            }
        }
    }
    print("TRAINING_STEP_NONFINITE status=pass nan_infinity_negative_infinity=true cold_warm=preserved")
}
test "prepared training preserves eager nonfinite propagation on cold and warm state" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true));nonfinite(device)
}

class TrainingCallbackCount {static var backwards:int=0}
struct TrainingIdentity:Autograd.Operation {
    func forward(inputs:Tensor[]) Tensor {return inputs[0]}
    func backward(inputs:Tensor[],output:Tensor,gradient:Tensor) Tensor[] {
        TrainingCallbackCount.backwards++
        return [gradient]
    }
}
public func graph_guards(device:GPU.Device) {
    var model=baseline_model(false);model.to(device)
    var optimizer=Optim.AdamW(model.parameters(),epsilon:0.01)
    let input=Tensor.ones([4,2]).to(device);let target=Tensor.zeros([4,2]).to(device)
    var plan=try Neural.TrainingStep.mse(model,optimizer,input,target) else error {panic(error)}
    var initial=try plan.run(input,target) else error {panic(error)}
    var source=Autograd.Variable(input)
    let custom=Autograd.apply(TrainingIdentity(),[source.value()]).tanh()
    let consumed=source.value().tanh()
    consumed.sum().backward()
    let nested_consumed=consumed.add(0.0)
    TrainingCallbackCount.backwards=0
    var before=optimizer.state()
    var parameters=model.parameters();var weights:Tensor[]=[];var gradients:Tensor?[]=[]
    for var parameter in parameters {weights.append(parameter.value().detach());gradients.append(parameter.gradient())}
    device.wait_until_idle()
    var profile=Profile(device);profile.reset()
    match plan.run(custom,target) {
        failure(reason)=>{assert(reason=="prepared training does not capture custom autograd callbacks")}
        success(value)=>{print("TRAINING_GRAPH_BEFORE callback_count=$(TrainingCallbackCount.backwards)");panic("custom callback unexpectedly executed")}
    }
    rejected_run(plan,input,custom);rejected_run(plan,nested_consumed,target);rejected_run(plan,input,nested_consumed)
    rejected_capture(model,optimizer,custom,target);rejected_capture(model,optimizer,input,custom)
    assert(TrainingCallbackCount.backwards==0)
    let rejected=profile.snapshot();assert(rejected.compute_passes==0 && rejected.submissions==0 && rejected.uploads==0 && rejected.downloads==0)
    state_near(before,optimizer.state(),0.0)
    var i=0
    while i<parameters.count() {near(weights[i],parameters[i].value(),0.0);optional_near(gradients[i],parameters[i].gradient(),0.0);i++}
    // Count bound: 2049 independent leaves + 2048 pure additions = 4097 nodes.
    // A balanced tree exercises cardinality without the separate cost of building
    // a deep chain in the runtime cycle collector.
    var roots:Tensor[]=[]
    for index in 0...2049 {
        var leaf=Autograd.Variable(Tensor.ones([4,2]))
        roots.append(leaf.value())
    }
    while roots.count()>1 {
        var next:Tensor[]=[]
        var index=0
        while index<roots.count() {
            if index+1<roots.count() {next.append(roots[index].add(roots[index+1]))}
            else {next.append(roots[index])}
            index+=2
        }
        roots=next
    }
    let deep=roots[0]
    match plan.run(deep,target) {
        failure(reason)=>{assert(reason=="prepared training supports at most 4096 input and target autograd nodes")}
        success(value)=>{panic("unbounded incoming graph unexpectedly accepted")}
    }
    assert(plan.statistics().executions==1 && plan.statistics().rejections==5)
    var compatible=try plan.run(input,target) else error {panic(error)}
    assert(plan.statistics().executions==2 && plan.statistics().last_rejection=="")
    print("TRAINING_STEP_GRAPH_GUARDS status=pass callbacks=0 consumed=before_zero_grad incoming_nodes=4096 hot_state=preserved")
}
test "prepared training rejects callback consumed and excessive incoming graphs before zero_grad" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true));graph_guards(device)
}
