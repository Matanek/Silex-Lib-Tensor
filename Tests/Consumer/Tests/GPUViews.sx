func compact_uint32(device:GPU.Device) {
    var values:uint32[] = [1 as uint32, 2 as uint32, 3 as uint32, 4 as uint32]
    var expected:uint32[] = [1 as uint32, 3 as uint32, 2 as uint32, 4 as uint32]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
