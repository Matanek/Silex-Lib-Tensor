    var values:int32[] = [1 as int32, 2 as int32, 3 as int32, 4 as int32]
    var expected:int32[] = [1 as int32, 3 as int32, 2 as int32, 4 as int32]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
    assert(result.dtype() == DType.int32() && equal_values<int32>(result.int32_values(), expected))
