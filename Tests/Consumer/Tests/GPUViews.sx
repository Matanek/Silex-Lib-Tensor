func compact_uint64(device:GPU.Device) {
    var values:uint64[] = [1 as uint64, 2 as uint64, 3 as uint64, 4 as uint64]
    var expected:uint64[] = [1 as uint64, 3 as uint64, 2 as uint64, 4 as uint64]
