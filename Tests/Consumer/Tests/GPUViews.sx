func compact_int64(device:GPU.Device) {
    var values:int64[] = [1 as int64, 2 as int64, 3 as int64, 4 as int64]
    var expected:int64[] = [1 as int64, 3 as int64, 2 as int64, 4 as int64]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
    assert(result.dtype() == DType.int64() && equal_values<int64>(result.int64_values(), expected))
