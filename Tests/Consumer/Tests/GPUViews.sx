    var values:int16[] = [1 as int16, 2 as int16, 3 as int16, 4 as int16]
    var expected:int16[] = [1 as int16, 3 as int16, 2 as int16, 4 as int16]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
