func compact_uint16(device:GPU.Device) {
    var values:uint16[] = [1 as uint16, 2 as uint16, 3 as uint16, 4 as uint16]
    var expected:uint16[] = [1 as uint16, 3 as uint16, 2 as uint16, 4 as uint16]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
    assert(result.dtype() == DType.uint16() && equal_values<uint16>(result.uint16_values(), expected))
}
