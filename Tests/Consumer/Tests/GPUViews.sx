use GFX.GPU
use Tensor
use Tensor.DType

func equal_values<T>(left:T[], right:T[]) bool {
    if left.count() != right.count() { return false }
    var index = 0
    while index < left.count() {
        if left[index] != right[index] { return false }
        index++
    }
    return true
}

func compact_float(device:GPU.Device) {
    var values:float[] = [1.0, 2.0, 3.0, 4.0]
    var expected:float[] = [1.0, 3.0, 2.0, 4.0]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
    assert(result.dtype() == DType.float32() && equal_values<float>(result.values(), expected))
}
func compact_int8(device:GPU.Device) {
    var values:int8[] = [1 as int8, 2 as int8, 3 as int8, 4 as int8]
    var expected:int8[] = [1 as int8, 3 as int8, 2 as int8, 4 as int8]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
    assert(result.dtype() == DType.int8() && equal_values<int8>(result.int8_values(), expected))
}
func compact_uint8(device:GPU.Device) {
    var values:uint8[] = [1 as uint8, 2 as uint8, 3 as uint8, 4 as uint8]
    var expected:uint8[] = [1 as uint8, 3 as uint8, 2 as uint8, 4 as uint8]
    let result = Tensor(values, [2, 2]).to(device).transpose().contiguous().cpu()
    assert(result.dtype() == DType.uint8() && equal_values<uint8>(result.uint8_values(), expected))
}
