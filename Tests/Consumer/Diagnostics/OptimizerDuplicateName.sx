use Tensor
use Tensor.Neural
use Tensor.Optim

func main() {
    var values:float[] = [1.0]
    var parameters:Neural.Parameter[] = [
        Neural.Parameter("weight", Tensor.vector(values)),
        Neural.Parameter("weight", Tensor.vector(values))
    ]
    var optimizer = Optim.SGD(parameters, learning_rate:0.1)
    optimizer.step()
}
