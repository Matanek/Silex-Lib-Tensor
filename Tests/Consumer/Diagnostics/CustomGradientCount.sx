use Tensor
use Tensor.Autograd
struct Rule:Autograd.Operation {
    func forward(inputs:Tensor[]) Tensor {return inputs[0].multiply(inputs[0])}
    func backward(inputs:Tensor[], output:Tensor, gradient:Tensor) Tensor[] {return []}
}
func main() {var input=Autograd.Variable(Tensor.scalar(2.0));Autograd.apply(Rule(),[input.value()]).backward()}
