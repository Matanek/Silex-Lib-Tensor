use Tensor
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU

func main() {
    var device=GPU.Device(GPU.DeviceSettings(debug:true))
    var model=Neural.LSTM("memory",2,2,seed:7)
    var other=GPU.Device(GPU.DeviceSettings(debug:true));model.to(device);model.unroll(Tensor.zeros([1,2,2]).to(device),initial_state:Neural.LSTMState(hidden:Tensor.zeros([1,2]).to(device),cell:Tensor.zeros([1,2]).to(other)))
}
