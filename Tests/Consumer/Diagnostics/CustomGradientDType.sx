use Tensor
use Tensor.Autograd
struct Rule:Autograd.Operation {
    func forward(inputs:Tensor[]) Tensor {return inputs[0]}
    func backward(inputs:Tensor[], output:Tensor, gradient:Tensor) Tensor[] {var data:int[]=[1];return [Tensor.vector(data)]}
}
func main() {var values:float[]=[2.0];var input=Autograd.Variable(Tensor.vector(values));Autograd.apply(Rule(),[input.value()]).sum().backward()}
