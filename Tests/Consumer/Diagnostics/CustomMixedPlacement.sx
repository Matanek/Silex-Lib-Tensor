use Tensor
use Tensor.Autograd
use GFX.GPU
struct Rule:Autograd.Operation {
    func forward(inputs:Tensor[]) Tensor {return inputs[0]}
    func backward(inputs:Tensor[], output:Tensor, gradient:Tensor) Tensor[] {return [gradient,gradient]}
}
func main() {var device=GPU.Device(GPU.DeviceSettings(debug:true));Autograd.apply(Rule(),[Tensor.scalar(2.0),Tensor.scalar(3.0).to(device)])}
