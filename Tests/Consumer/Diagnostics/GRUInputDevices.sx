use Tensor
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU

func main() {
    var device=GPU.Device(GPU.DeviceSettings(debug:true))
    var model=Neural.GRU("memory",2,2,seed:7)
    var other=GPU.Device(GPU.DeviceSettings(debug:true));model.to(device);model.forward(Tensor.zeros([1,2,2]).to(other))
}
