use Tensor
use Tensor.DType
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU
use STD.Math
func main() {var model=Neural.MultiHeadAttention("attention",2,2,seed:13);var device=GPU.Device();model.to(device);let x=Tensor.ones([1,2,2]).to(device);let output=model.attend(x,x,x,mask:Tensor.scalar(true))}
