use Tensor
use Tensor.DType
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU
use STD.Math
func main() {var model=Neural.TransformerBlock("block",4,2,6,seed:17);var first=GPU.Device();var second=GPU.Device();model.to(first);let x=Tensor.ones([1,2,4]).to(first);let result=model.encode(x,mask:Tensor.scalar(true).to(second))}
