use Tensor
use Tensor.DType
use Tensor.Autograd
use GFX.GPU
use STD.Math
func identity(inputs:Tensor[]) Tensor { return inputs[0].multiply(inputs[0]) }
func changing_shape(inputs:Tensor[]) Tensor { if inputs[0].item() > 0.0 { return Tensor.ones([1]) }
 return Tensor.ones([2]) }
func main() {
    let result = Autograd.gradcheck(changing_shape,[Tensor.scalar(0.0)],epsilon:0.001,absolute_tolerance:0.001,relative_tolerance:0.001); print(result.passed)
}
