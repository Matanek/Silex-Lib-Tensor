use Tensor
use Tensor.DType
use Tensor.Autograd
use GFX.GPU
use STD.Math
func identity(inputs:Tensor[]) Tensor { return inputs[0].multiply(inputs[0]) }
func main() {
    let result = Autograd.gradcheck(identity,[Tensor.scalar(1000000000.0)],epsilon:0.000001,absolute_tolerance:0.001,relative_tolerance:0.001); print(result.passed)
}
