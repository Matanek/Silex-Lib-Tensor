use Tensor
use Tensor.DType
use Tensor.Neural
use Tensor.Autograd
use GFX.GPU
use STD.Math
func main() {var model=Neural.MultiHeadAttention("attention",2,2,seed:13);var first=GPU.Device();var second=GPU.Device();let output=model.attend(Tensor.ones([1,2,2]).to(first),Tensor.ones([1,3,2]).to(second),Tensor.ones([1,3,2]).to(first))}
