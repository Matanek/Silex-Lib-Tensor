use Tensor
use Tensor.DType
use Tensor.Autograd
use GFX.GPU
use STD.Math
func identity(inputs:Tensor[]) Tensor { return inputs[0].multiply(inputs[0]) }
func main() {
    var device = GPU.Device(); var other = GPU.Device(); var x = Autograd.Variable(Tensor.scalar(1.0).to(device)); var result = Autograd.grad(x.value().multiply(2.0),[x.value()],seed:Tensor.scalar(1.0).to(other)); print(result.count())
}
