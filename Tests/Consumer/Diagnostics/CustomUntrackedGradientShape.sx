use Tensor
use Tensor.Autograd
struct Rule:Autograd.Operation {
    func forward(inputs:Tensor[]) Tensor {return inputs[0].sum()}
    func backward(inputs:Tensor[], output:Tensor, gradient:Tensor) Tensor[] {
        return [inputs[0].multiply(0.0).add(gradient),Tensor.scalar(0.0)]
    }
}
func main() {
    var values:float[]=[2.0,3.0]
    var input=Autograd.Variable(Tensor.vector(values))
    Autograd.apply(Rule(),[input.value(),Tensor.vector(values)]).backward()
}
