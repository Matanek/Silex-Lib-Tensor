use GFX.GPU
use Tensor
use Tensor.Autograd.Variable

func main() {
    var device = GPU.Device()
    var values:float[] = [1.0, 2.0]
    var seed_values:float[] = [1.0, 1.0]
    var input = Variable(Tensor.vector(values).to(device))
    input.value().multiply(2.0).backward(Tensor.vector(seed_values))
}
