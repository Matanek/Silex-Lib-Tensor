use Tensor
use Tensor.Neural
use Tensor.Autograd
use Tensor.Profile
use Tensor.autograd_performance_statistics
use GFX.GPU

func transformer_graph(device:GPU.Device,mode:int,return_weights:bool,norm_first:bool,iteration:int) {
    var model=Neural.TransformerBlock("block",4,2,6,seed:13,norm_first:norm_first,dropout_probability:0.25)
    model.to(device)
    var input=Autograd.Variable(Tensor.linspace(-0.5,0.75,8).reshape([1,2,4]).to(device))
    let mask=Neural.causal_mask(2,2).to(device)
    let result=model.encode(input.value(),mask:mask,iteration:iteration,return_weights:return_weights)
    if mode==0 {result.output.sum().backward()}
    elif mode==1 {var gradients=Autograd.grad(result.output,[input.value()],seed:input.value());assert(gradients.count()==1)}
    if let weights=result.weights {assert(weights.count()==8)}
}
// Bounds are the retained-ancestor worst case, measured with early fence release
// disabled; production Storage is unchanged. First-cycle peaks are timing-dependent.
test "Transformer optional graphs stay within retained-ancestor bounds and release every resource" {
    if !GPU.Device.is_supported() {return}
    var device=GPU.Device(GPU.DeviceSettings(debug:true))
    let baseline=autograd_performance_statistics();var profile=Profile(device);var cycle=0;var peak=0
    var bounds:int[]=[6252,6252,6180,6180,2332,2332,6252,6252,6180,6180,2332,2332]
    var allocations:int[]=[202,202,198,198,81,81,202,202,198,198,81,81]
    while cycle<16 {
        var index=0
        for norm_first in [true,false] {
            var mode=0
            while mode<3 {
                for weights in [false,true] {
                    profile.reset()
                    transformer_graph(device,mode,weights,norm_first,cycle)
                    let stats=profile.snapshot()
                    assert(stats.live_buffers==0 && stats.active_bytes==0 && stats.buffer_allocations==stats.buffer_releases && stats.cached_bytes==0 && stats.allocated_bytes==0)
                    assert(stats.buffer_allocations+stats.buffer_reuses==allocations[index] && stats.peak_bytes<=bounds[index] && stats.downloads==0)
                    assert(autograd_performance_statistics().live_nodes==baseline.live_nodes)
                    if stats.peak_bytes>peak {peak=stats.peak_bytes}
                    index++
                }
                mode++
            }
        }
        cycle++
    }
    let after=autograd_performance_statistics()
    assert(after.edge_retentions-baseline.edge_retentions==after.edge_releases-baseline.edge_releases)
    print("Transformer lifetime peak bytes: ",peak," retained-ancestor bound: 6252")
}
